import Mathlib.Algebra.Lie.OfAssociative
import Mathlib.Analysis.Normed.Algebra.Exponential
import Mathlib.Analysis.Normed.Module.FiniteDimension
import Mathlib.Analysis.SpecialFunctions.Exponential
import Mathlib.LinearAlgebra.Basis.VectorSpace
import Mathlib.RepresentationTheory.Basic
import Mathlib.Tactic

/-!
# Exponential integration of finite-dimensional Lie-module invariants

This file isolates two elementary parts of the group-to-Lie bridge.  First, a
finite-dimensional subspace invariant under an endomorphism is invariant under
its Banach-algebra exponential.  Second, stability (or triviality) on a set of
exponential generators extends to the group generated by their finite
products.

The genuinely analytic input remains the compatibility of a differentiated
group representation with these exponentials and exponential generation of
the compact group.
-/

namespace GUT
namespace ExponentialRepresentationBridge

noncomputable section

open NormedSpace

universe u v w

section EndomorphismExponential

variable {V : Type u} [NormedAddCommGroup V] [NormedSpace ℂ V]
  [FiniteDimensional ℂ V]

/-- The continuous endomorphisms preserving a fixed complex subspace form a
subalgebra. -/
def preservingEndomorphisms (N : Submodule ℂ V) :
    Subalgebra ℂ (V →L[ℂ] V) where
  carrier := {f | ∀ ⦃v : V⦄, v ∈ N → f v ∈ N}
  zero_mem' := by simp
  one_mem' := by simp
  add_mem' := by
    intro f g hf hg v hv
    exact N.add_mem (hf hv) (hg hv)
  mul_mem' := by
    intro f g hf hg v hv
    exact hf (hg hv)
  algebraMap_mem' := by
    intro c v hv
    exact N.smul_mem c hv

/-- In finite dimension, the algebra of endomorphisms preserving a subspace is
closed in operator norm. -/
theorem preservingEndomorphisms_isClosed (N : Submodule ℂ V) :
    IsClosed (preservingEndomorphisms N : Set (V →L[ℂ] V)) := by
  change IsClosed {f : V →L[ℂ] V | ∀ ⦃v : V⦄, v ∈ N → f v ∈ N}
  have hN : IsClosed (N : Set V) := Submodule.closed_of_finiteDimensional N
  rw [show {f : V →L[ℂ] V | ∀ ⦃v : V⦄, v ∈ N → f v ∈ N} =
      ⋂ v ∈ (N : Set V), {f : V →L[ℂ] V | f v ∈ N} by
    ext f
    simp]
  exact isClosed_biInter fun v _hv =>
    hN.preimage
      (ContinuousLinearMap.apply ℂ V v :
        (V →L[ℂ] V) →L[ℂ] V).continuous

/-- An invariant finite-dimensional subspace is invariant under the operator
exponential. -/
theorem exp_apply_mem_of_forall_mem
    (N : Submodule ℂ V) (D : V →L[ℂ] V)
    (hD : ∀ ⦃v : V⦄, v ∈ N → D v ∈ N)
    {v : V} (hv : v ∈ N) :
    exp D v ∈ N := by
  let : NormedAlgebra ℚ (V →L[ℂ] V) :=
    NormedAlgebra.restrictScalars ℚ ℂ (V →L[ℂ] V)
  let : IsScalarTower ℚ ℂ (V →L[ℂ] V) :=
    IsScalarTower.restrictScalars ℚ ℂ (V →L[ℂ] V)
  have hmem : exp D ∈ preservingEndomorphisms N :=
    exp_mem (R := ℂ) (preservingEndomorphisms_isClosed N) hD
  exact hmem hv

/-- The operator exponential acts on an eigenvector by exponentiating its
eigenvalue. -/
theorem exp_apply_of_apply_eq_smul
    (D : V →L[ℂ] V) {v : V} {c : ℂ} (hv : D v = c • v) :
    exp D v = Complex.exp c • v := by
  let : CompleteSpace V := FiniteDimensional.complete ℂ V
  have hpow : ∀ n : ℕ, (D ^ n) v = c ^ n • v := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
        rw [pow_succ', mul_apply_eq_comp, ih, map_smul, hv,
          smul_smul, pow_succ]
  rw [NormedSpace.exp_eq_tsum ℂ]
  change (ContinuousLinearMap.apply ℂ V v)
    (∑' n : ℕ, (n.factorial : ℂ)⁻¹ • D ^ n) = _
  rw [(ContinuousLinearMap.apply ℂ V v).map_tsum
    (NormedSpace.expSeries_summable' D)]
  simp_rw [map_smul, ContinuousLinearMap.apply_apply, hpow, smul_smul]
  have hsum : Summable (fun n : ℕ => (n.factorial : ℂ)⁻¹ * c ^ n) := by
    simpa [smul_eq_mul] using
      (NormedSpace.expSeries_summable' (𝕂 := ℂ) c)
  rw [hsum.tsum_smul_const]
  rw [Complex.exp_eq_exp_ℂ]
  exact congrArg (fun z : ℂ => z • v) (by
    simpa [smul_eq_mul] using
      (congrFun (NormedSpace.exp_eq_tsum ℂ) c).symm)

end EndomorphismExponential

section BasisExponential

variable {V : Type u} [AddCommGroup V] [Module ℂ V]
variable {ι : Type v} [Fintype ι]

/-- The exponential of an endomorphism, computed after transporting it to the
canonical normed coordinate space of a finite basis.  Keeping the basis
explicit avoids imposing a topology on the original vector space. -/
def basisExponential (b : Module.Basis ι ℂ V) (D : Module.End ℂ V) :
    Module.End ℂ V :=
  (b.equivFun.conjAlgEquiv ℂ).symm
    ((Module.End.toContinuousLinearMap (ι → ℂ)).symm
      (exp
        (Module.End.toContinuousLinearMap (ι → ℂ)
          (b.equivFun.conjAlgEquiv ℂ D))))

@[simp]
theorem basisExponential_zero (b : Module.Basis ι ℂ V) :
    basisExponential b 0 = LinearMap.id := by
  rw [basisExponential, map_zero, map_zero, exp_zero, map_one, map_one]
  exact Module.End.one_eq_id

/-- Conjugating the basis-defined exponential into coordinates gives the
ordinary operator exponential on the coordinate space. -/
theorem equivFun_basisExponential_apply
    (b : Module.Basis ι ℂ V) (D : Module.End ℂ V) (v : V) :
    b.equivFun (basisExponential b D v) =
      exp
        (Module.End.toContinuousLinearMap (ι → ℂ)
          (b.equivFun.conjAlgEquiv ℂ D))
        (b.equivFun v) := by
  let A : Module.End ℂ (ι → ℂ) :=
    (Module.End.toContinuousLinearMap (ι → ℂ)).symm
      (exp
        (Module.End.toContinuousLinearMap (ι → ℂ)
          (b.equivFun.conjAlgEquiv ℂ D)))
  change b.equivFun (((b.equivFun.conjAlgEquiv ℂ).symm A) v) = A (b.equivFun v)
  classical
  simpa [Pi.basisFun_apply, Finsupp.single_eq_pi_single] using
    (Pi.basisFun ℂ ι).sum_repr (A (b.equivFun v))

/-- The basis-defined finite-dimensional exponential preserves every
subspace preserved by the original endomorphism. -/
theorem basisExponential_apply_mem_of_forall_mem
    (b : Module.Basis ι ℂ V) (N : Submodule ℂ V) (D : Module.End ℂ V)
    (hD : ∀ ⦃v : V⦄, v ∈ N → D v ∈ N)
    {v : V} (hv : v ∈ N) :
    basisExponential b D v ∈ N := by
  let e : V ≃ₗ[ℂ] (ι → ℂ) := b.equivFun
  let N' : Submodule ℂ (ι → ℂ) := N.map e.toLinearMap
  let D' : Module.End ℂ (ι → ℂ) := e.conjAlgEquiv ℂ D
  have hD' : ∀ ⦃y : ι → ℂ⦄, y ∈ N' → D' y ∈ N' := by
    intro y hy
    simp only [N', Submodule.mem_map_equiv] at hy ⊢
    simpa [D', e, LinearEquiv.conjAlgEquiv_apply,
      LinearMap.comp_apply] using hD hy
  have hv' : e v ∈ N' := by
    simp only [N', Submodule.mem_map_equiv]
    simpa using hv
  have hExp := exp_apply_mem_of_forall_mem N'
    (Module.End.toContinuousLinearMap (ι → ℂ) D') hD' hv'
  have hCoordinate : e (basisExponential b D v) ∈ N' := by
    change b.equivFun (basisExponential b D v) ∈ N'
    rw [equivFun_basisExponential_apply]
    exact hExp
  have hBack := (Submodule.mem_map_equiv (p := N) (e := e)).mp hCoordinate
  simpa using hBack

/-- Eigenvectors are exponentiated with their scalar eigenvalue by the
basis-transported exponential. -/
theorem basisExponential_apply_of_apply_eq_smul
    (b : Module.Basis ι ℂ V) (D : Module.End ℂ V)
    {v : V} {c : ℂ} (hv : D v = c • v) :
    basisExponential b D v = Complex.exp c • v := by
  apply b.equivFun.injective
  rw [equivFun_basisExponential_apply, map_smul]
  apply exp_apply_of_apply_eq_smul
  simpa [Module.End.toContinuousLinearMap, LinearEquiv.conjAlgEquiv_apply,
    LinearMap.comp_apply] using congrArg b.equivFun hv

end BasisExponential

section FiniteDimensionalExponential

variable {V : Type u} [AddCommGroup V] [Module ℂ V]
  [FiniteDimensional ℂ V]

/-- A basis-hidden interface to the chosen-basis construction.  The
chosen vector-space basis is implementation data; the compatibility theorem
for a differentiated representation may use this fixed definition. -/
def finiteDimensionalExponential (D : Module.End ℂ V) : Module.End ℂ V :=
  basisExponential (Module.Basis.ofVectorSpace ℂ V) D

@[simp]
theorem finiteDimensionalExponential_zero :
    finiteDimensionalExponential (V := V) 0 = LinearMap.id :=
  basisExponential_zero (Module.Basis.ofVectorSpace ℂ V)

theorem finiteDimensionalExponential_apply_mem_of_forall_mem
    (N : Submodule ℂ V) (D : Module.End ℂ V)
    (hD : ∀ ⦃v : V⦄, v ∈ N → D v ∈ N)
    {v : V} (hv : v ∈ N) :
    finiteDimensionalExponential D v ∈ N :=
  basisExponential_apply_mem_of_forall_mem
    (Module.Basis.ofVectorSpace ℂ V) N D hD hv

/-- Canonical chosen-basis specialization of the eigenvector formula. -/
theorem finiteDimensionalExponential_apply_of_apply_eq_smul
    (D : Module.End ℂ V) {v : V} {c : ℂ} (hv : D v = c • v) :
    finiteDimensionalExponential D v = Complex.exp c • v :=
  basisExponential_apply_of_apply_eq_smul
    (Module.Basis.ofVectorSpace ℂ V) D hv

end FiniteDimensionalExponential

section GeneratedGroup

variable {G : Type u} [Group G]
variable {P : Type v}
variable {V : Type w} [AddCommGroup V] [Module ℂ V]

/-- A chosen family whose finite products cover a group.  No algebraic
structure on the parameter type is needed for the finite-product arguments. -/
structure FiniteProductGeneration (G : Type u) [Group G] (P : Type v) where
  generator : P → G
  generates : ∀ g : G, ∃ xs : List P, (xs.map generator).prod = g

namespace FiniteProductGeneration

/-- A surjective family generates the group using one-element products. -/
def ofSurjective (generator : P → G) (hGenerator : Function.Surjective generator) :
    FiniteProductGeneration G P where
  generator := generator
  generates g := by
    obtain ⟨x, rfl⟩ := hGenerator g
    exact ⟨[x], by simp⟩

end FiniteProductGeneration

/-- Invariance under each chosen generator extends to the whole represented
group. -/
theorem group_stable_of_finiteProductGeneration
    (rho : Representation ℂ G V)
    (E : FiniteProductGeneration G P)
    (N : Submodule ℂ V)
    (hGenerator : ∀ x : P, ∀ ⦃v : V⦄, v ∈ N → rho (E.generator x) v ∈ N) :
    ∀ g : G, ∀ ⦃v : V⦄, v ∈ N → rho g v ∈ N := by
  intro g
  obtain ⟨xs, rfl⟩ := E.generates g
  induction xs with
  | nil => simp
  | cons x xs ih =>
      intro v hv
      rw [List.map_cons, List.prod_cons, map_mul, Module.End.mul_apply]
      exact hGenerator x (ih hv)

/-- If every chosen generator acts as the identity, so does every group
element generated by their finite products. -/
theorem action_eq_id_of_finiteProductGeneration
    (rho : Representation ℂ G V)
    (E : FiniteProductGeneration G P)
    (hGenerator : ∀ x : P, rho (E.generator x) = LinearMap.id) :
    ∀ g : G, rho g = LinearMap.id := by
  intro g
  obtain ⟨xs, rfl⟩ := E.generates g
  induction xs with
  | nil => simp [Module.End.one_eq_id]
  | cons x xs ih =>
      rw [List.map_cons, List.prod_cons, map_mul, hGenerator x, ih]
      exact Module.End.one_eq_id

end GeneratedGroup

section LieIntegration

variable {G : Type u} [Group G]
variable {L : Type v} [LieRing L] [LieAlgebra ℂ L]
variable {V : Type w} [AddCommGroup V] [Module ℂ V]
  [LieRingModule L V] [LieModule ℂ L V]
variable {P : Type*} {ι : Type*} [Fintype ι]

/-- Exponential compatibility on a finite-product generating family makes
every Lie submodule stable under the original group representation. -/
theorem lieSubmodule_group_stable_of_basisExponential
    (rho : Representation ℂ G V)
    (E : FiniteProductGeneration G P)
    (toComplexLie : P → L)
    (b : Module.Basis ι ℂ V)
    (hAction : ∀ x : P,
      rho (E.generator x) =
        basisExponential b (LieModule.toEnd ℂ L V (toComplexLie x))) :
    ∀ (N : LieSubmodule ℂ L V) (g : G) ⦃v : V⦄,
      v ∈ N → rho g v ∈ N := by
  intro N
  apply group_stable_of_finiteProductGeneration rho E (N : Submodule ℂ V)
  intro x v hv
  rw [hAction x]
  apply basisExponential_apply_mem_of_forall_mem b (N : Submodule ℂ V)
  · intro w hw
    change ⁅toComplexLie x, w⁆ ∈ N
    exact N.lie_mem hw
  · exact hv

/-- If the differential is zero and the group action agrees with its
endomorphism exponential on finite-product generators, the whole group action
is trivial. -/
theorem action_eq_id_of_basisExponential_of_lieAction_eq_zero
    (rho : Representation ℂ G V)
    (E : FiniteProductGeneration G P)
    (toComplexLie : P → L)
    (b : Module.Basis ι ℂ V)
    (hAction : ∀ x : P,
      rho (E.generator x) =
        basisExponential b (LieModule.toEnd ℂ L V (toComplexLie x)))
    (hZero : ∀ X : L, ∀ v : V, ⁅X, v⁆ = 0) :
    ∀ g : G, rho g = LinearMap.id := by
  apply action_eq_id_of_finiteProductGeneration rho E
  intro x
  rw [hAction x]
  have hEnd : LieModule.toEnd ℂ L V (toComplexLie x) = 0 := by
    ext v
    simpa only [LieModule.toEnd_apply_apply, LinearMap.zero_apply] using
      hZero (toComplexLie x) v
  rw [hEnd, basisExponential_zero]

/-- Canonical finite-dimensional specialization of
`lieSubmodule_group_stable_of_basisExponential`. -/
theorem lieSubmodule_group_stable_of_finiteDimensionalExponential
    [FiniteDimensional ℂ V]
    (rho : Representation ℂ G V)
    (E : FiniteProductGeneration G P)
    (toComplexLie : P → L)
    (hAction : ∀ x : P,
      rho (E.generator x) =
        finiteDimensionalExponential
          (LieModule.toEnd ℂ L V (toComplexLie x))) :
    ∀ (N : LieSubmodule ℂ L V) (g : G) ⦃v : V⦄,
      v ∈ N → rho g v ∈ N :=
  lieSubmodule_group_stable_of_basisExponential rho E toComplexLie
    (Module.Basis.ofVectorSpace ℂ V) hAction

/-- Canonical finite-dimensional specialization of the zero-differential
integration theorem. -/
theorem action_eq_id_of_finiteDimensionalExponential_of_lieAction_eq_zero
    [FiniteDimensional ℂ V]
    (rho : Representation ℂ G V)
    (E : FiniteProductGeneration G P)
    (toComplexLie : P → L)
    (hAction : ∀ x : P,
      rho (E.generator x) =
        finiteDimensionalExponential
          (LieModule.toEnd ℂ L V (toComplexLie x)))
    (hZero : ∀ X : L, ∀ v : V, ⁅X, v⁆ = 0) :
    ∀ g : G, rho g = LinearMap.id :=
  action_eq_id_of_basisExponential_of_lieAction_eq_zero rho E toComplexLie
    (Module.Basis.ofVectorSpace ℂ V) hAction hZero

end LieIntegration

end

