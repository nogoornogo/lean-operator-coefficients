open Math

/-!
# From derivatives at the identity to exponential compatibility

Finite-dimensional representations are transported to the canonical normed
coordinate space selected by `Module.Basis.ofVectorSpace`.  Along every
compact one-parameter subgroup, the derivative at zero and the group law then
determine the entire operator curve.  At time one this proves the exponential
compatibility consumed by the semisimple embedding classification integration bridge.
-/

namespace GUT
namespace DifferentiatedRepresentationBridge

noncomputable section

open CompactEmbeddingClassification ExponentialRepresentationBridge
  OneParameterSubgroup SpecialUnitaryLieAlgebra
open NormedSpace

attribute [local instance] LieRing.ofAssociativeRing

universe u v

section Coordinates

variable {V : Type u} [AddCommGroup V] [Module ℂ V]
  [FiniteDimensional ℂ V]

/-- The index type of mathlib's selected vector-space basis. -/
abbrev CoordinateIndex := Module.Basis.ofVectorSpaceIndex ℂ V

/-- The canonical normed coordinate space used for an abstract
finite-dimensional complex vector space. -/
abbrev CoordinateSpace := CoordinateIndex (V := V) → ℂ

/-- Transport an abstract endomorphism to a continuous endomorphism of the
selected coordinate space. -/
def coordinateEndomorphismEquiv :
    Module.End ℂ V ≃ₐ[ℂ]
      (CoordinateSpace (V := V) →L[ℂ] CoordinateSpace (V := V)) :=
  ((Module.Basis.ofVectorSpace ℂ V).equivFun.conjAlgEquiv ℂ).trans
    (Module.End.toContinuousLinearMap (CoordinateSpace (V := V)))

/-- Applying a transported endomorphism to transported coordinates agrees
with transporting its action on the original vector. -/
lemma coordinateEndomorphismEquiv_apply
    (f : Module.End ℂ V) (v : V) :
    coordinateEndomorphismEquiv f
        ((Module.Basis.ofVectorSpace ℂ V).equivFun v) =
      (Module.Basis.ofVectorSpace ℂ V).equivFun (f v) := by
  simp only [coordinateEndomorphismEquiv]
  change
    (Module.Basis.ofVectorSpace ℂ V).equivFun
      (f ((Module.Basis.ofVectorSpace ℂ V).equivFun.symm
        ((Module.Basis.ofVectorSpace ℂ V).equivFun v))) =
      (Module.Basis.ofVectorSpace ℂ V).equivFun (f v)
  apply congrArg (Module.Basis.ofVectorSpace ℂ V).equivFun
  apply congrArg f
  exact (Module.Basis.ofVectorSpace ℂ V).equivFun.symm_apply_apply v

/-- Coordinate transport followed by transport back leaves an endomorphism
application unchanged. -/
lemma coordinateEndomorphismEquiv_back_apply
    (f : Module.End ℂ V) (v : V) :
    (Module.Basis.ofVectorSpace ℂ V).equivFun.symm
        (coordinateEndomorphismEquiv f
          ((Module.Basis.ofVectorSpace ℂ V).equivFun v)) =
      f v := by
  rw [coordinateEndomorphismEquiv_apply]
  exact (Module.Basis.ofVectorSpace ℂ V).equivFun.symm_apply_apply (f v)

/-- The basis-hidden finite-dimensional exponential becomes the ordinary
Banach-algebra exponential after transport to coordinates. -/
lemma coordinateEndomorphismEquiv_finiteDimensionalExponential
    (D : Module.End ℂ V) :
    coordinateEndomorphismEquiv (finiteDimensionalExponential D) =
      exp (coordinateEndomorphismEquiv D) := by
  simp [coordinateEndomorphismEquiv, finiteDimensionalExponential,
    basisExponential]

end Coordinates

section RepresentationCurve

variable {n : Type u} [Fintype n] [DecidableEq n]
variable {V : Type v} [AddCommGroup V] [Module ℂ V]
  [FiniteDimensional ℂ V]

/-- The action of the compact one-parameter subgroup generated by `X`, in
the selected normed coordinates. -/
def coordinateActionCurve
    (rho : Representation ℂ (Matrix.specialUnitaryGroup n ℂ) V)
    (X : CompactRealForm n) (t : ℝ) :
    CoordinateSpace (V := V) →L[ℂ] CoordinateSpace (V := V) :=
  coordinateEndomorphismEquiv
    (rho (CompactRealForm.expSpecialUnitary (t • X)))

lemma coordinateActionCurve_add
    (rho : Representation ℂ (Matrix.specialUnitaryGroup n ℂ) V)
    (X : CompactRealForm n) (s t : ℝ) :
    coordinateActionCurve rho X (s + t) =
      coordinateActionCurve rho X s * coordinateActionCurve rho X t := by
  simp only [coordinateActionCurve,
    CompactRealForm.expSpecialUnitary_real_smul_add, map_mul]

lemma coordinateActionCurve_zero
    (rho : Representation ℂ (Matrix.specialUnitaryGroup n ℂ) V)
    (X : CompactRealForm n) :
    coordinateActionCurve rho X 0 = 1 := by
  simp [coordinateActionCurve]

/-- The derivative at the identity of every compact one-parameter subgroup
forces the representation/exponential compatibility equation. -/
theorem action_exp_of_hasRealDerivAt_zero
    {L : Type*} [LieRing L] [LieAlgebra ℂ L]
    [LieRingModule L V] [LieModule ℂ L V]
    (rho : Representation ℂ (Matrix.specialUnitaryGroup n ℂ) V)
    (toComplexLie : CompactRealForm n → L)
    (hDeriv : ∀ X : CompactRealForm n,
      HasRealDerivAt (coordinateActionCurve rho X)
        (coordinateEndomorphismEquiv
          (LieModule.toEnd ℂ L V (toComplexLie X))) 0)
    (X : CompactRealForm n) :
    rho (CompactRealForm.expSpecialUnitary X) =
      finiteDimensionalExponential
        (LieModule.toEnd ℂ L V (toComplexLie X)) := by
  let D : Module.End ℂ V := LieModule.toEnd ℂ L V (toComplexLie X)
  have hCurve := eq_exp_of_hasRealDerivAt_zero
    (coordinateActionCurve rho X) (coordinateEndomorphismEquiv D)
    (coordinateActionCurve_add rho X)
    (coordinateActionCurve_zero rho X) (hDeriv X) 1
  apply coordinateEndomorphismEquiv.injective
  rw [coordinateEndomorphismEquiv_finiteDimensionalExponential]
  simpa [coordinateActionCurve, D] using hCurve

end RepresentationCurve

/-!
## Differentials as Lie algebra homomorphisms

For a smooth representation the differential at the identity is naturally a
real Lie algebra homomorphism on the compact real form.  The explicit
complexification theorem for `su(n)` extends it to a complex Lie algebra
homomorphism on `sl(n,C)`.  Recording these maps directly is more intrinsic
than asking callers to manufacture typeclass instances for the induced
Lie-module action.
-/

/-- A finite-dimensional group representation together with its
complex-linear Lie-algebra differential and the derivative identity along the
concrete compact one-parameter subgroups. -/
structure LieHomDerivativeAtIdentityAction
    {n : Type u} [Fintype n] [DecidableEq n]
    {L : Type v} [LieRing L] [LieAlgebra ℂ L]
    {V : Type*} [AddCommGroup V] [Module ℂ V]
    (rho : Representation ℂ (Matrix.specialUnitaryGroup n ℂ) V)
    (toComplexLie : CompactRealForm n → L) where
  [finiteDimensional : FiniteDimensional ℂ V]
  differential : L →ₗ⁅ℂ⁆ Module.End ℂ V
  derivative_at_zero : ∀ X : CompactRealForm n,
    HasRealDerivAt (coordinateActionCurve rho X)
      (coordinateEndomorphismEquiv
        (differential (toComplexLie X))) 0

namespace LieHomDerivativeAtIdentityAction

/-- Pull the tautological action of `End(V)` back along the supplied
differential. -/
@[instance_reducible] def lieRingModule
    {n : Type u} [Fintype n] [DecidableEq n]
    {L : Type v} [LieRing L] [LieAlgebra ℂ L]
    {V : Type*} [AddCommGroup V] [Module ℂ V]
    {rho : Representation ℂ (Matrix.specialUnitaryGroup n ℂ) V}
    {toComplexLie : CompactRealForm n → L}
    (D : LieHomDerivativeAtIdentityAction rho toComplexLie) :
    LieRingModule L V :=
  LieRingModule.compLieHom V D.differential

/-- The pulled-back endomorphism action is a complex Lie module. -/
theorem lieModule
    {n : Type u} [Fintype n] [DecidableEq n]
    {L : Type v} [LieRing L] [LieAlgebra ℂ L]
    {V : Type*} [AddCommGroup V] [Module ℂ V]
    {rho : Representation ℂ (Matrix.specialUnitaryGroup n ℂ) V}
    {toComplexLie : CompactRealForm n → L}
    (D : LieHomDerivativeAtIdentityAction rho toComplexLie) :
    @LieModule ℂ L V _ _ _ _ _ D.lieRingModule :=
  LieModule.compLieHom V D.differential

/-- The abstract `LieModule.toEnd` map of the pulled-back action is exactly
the supplied differential. -/
theorem toEnd_eq_differential
    {n : Type u} [Fintype n] [DecidableEq n]
    {L : Type v} [LieRing L] [LieAlgebra ℂ L]
    {V : Type*} [AddCommGroup V] [Module ℂ V]
    {rho : Representation ℂ (Matrix.specialUnitaryGroup n ℂ) V}
    {toComplexLie : CompactRealForm n → L}
    (D : LieHomDerivativeAtIdentityAction rho toComplexLie) (X : L) :
    letI : LieRingModule L V := D.lieRingModule
    letI : LieModule ℂ L V := D.lieModule
    LieModule.toEnd ℂ L V X = D.differential X := by
  ext v
  rfl

set_option linter.style.haveILetI false in
/-- A compatible complex differential is unique: derivatives are unique on
compact directions, and those directions complex-linearly span `sl(n,C)`. -/
theorem differential_unique
    {n : Type u} [Fintype n] [DecidableEq n]
    {V : Type*} [AddCommGroup V] [Module ℂ V]
    {rho : Representation ℂ (Matrix.specialUnitaryGroup n ℂ) V}
    (D E : LieHomDerivativeAtIdentityAction rho
      (CompactRealForm.toSpecialLinear : CompactRealForm n →
        LieAlgebra.SpecialLinear.sl n ℂ)) :
    D.differential = E.differential := by
  letI : FiniteDimensional ℂ V := D.finiteDimensional
  have hLinear : D.differential.toLinearMap = E.differential.toLinearMap := by
    apply CompactRealForm.linearMap_ext
    intro X
    apply coordinateEndomorphismEquiv.injective
    exact (D.derivative_at_zero X).unique (E.derivative_at_zero X)
  apply LieHom.ext
  intro Z
  exact LinearMap.congr_fun hLinear Z

end LieHomDerivativeAtIdentityAction

/-- The differential data in the form naturally produced by differentiating
a smooth `SU(n)` representation: a real Lie homomorphism on `su(n)`, together
with its value as the derivative of every compact one-parameter action. -/
structure RealLieHomDerivativeAtIdentityAction
    {n : Type u} [Fintype n] [DecidableEq n]
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    (rho : Representation ℂ (Matrix.specialUnitaryGroup n ℂ) V) where
  [finiteDimensional : FiniteDimensional ℂ V]
  differential : CompactRealForm n →ₗ⁅ℝ⁆
    RestrictScalars ℝ ℂ (Module.End ℂ V)
  derivative_at_zero : ∀ X : CompactRealForm n,
    HasRealDerivAt (coordinateActionCurve rho X)
      (coordinateEndomorphismEquiv (differential X)) 0

namespace RealLieHomDerivativeAtIdentityAction

/-- Operator differentiation in canonical coordinates differentiates every
vector orbit in the original finite-dimensional normed space. -/
theorem orbit_derivative_at_zero
    {n : Type u} [Fintype n] [DecidableEq n]
    {V : Type v} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
    {rho : Representation ℂ (Matrix.specialUnitaryGroup n ℂ) V}
    (D : RealLieHomDerivativeAtIdentityAction rho)
    (X : CompactRealForm n) (v : V) :
    HasDerivAt
      (fun t : ℝ => rho (CompactRealForm.expSpecialUnitary (t • X)) v)
      ((show Module.End ℂ V from D.differential X) v) 0 := by
  let : FiniteDimensional ℂ V := D.finiteDimensional
  let b := Module.Basis.ofVectorSpace ℂ V
  let e : V ≃L[ℂ] CoordinateSpace (V := V) :=
    b.equivFun.toContinuousLinearEquiv
  let ev :
      (CoordinateSpace (V := V) →L[ℂ] CoordinateSpace (V := V)) →L[ℝ]
        CoordinateSpace (V := V) :=
    ((ContinuousLinearMap.apply ℂ (CoordinateSpace (V := V)))
      (e v)).restrictScalars ℝ
  have hOperator := D.derivative_at_zero X
  change HasDerivAt (coordinateActionCurve rho X)
    (coordinateEndomorphismEquiv (D.differential X)) 0 at hOperator
  have hEval := ev.hasFDerivAt.comp_hasDerivAt 0 hOperator
  have hBack :=
    (e.symm.toContinuousLinearMap.restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt
      0 hEval
  convert hBack using 1
  · funext t
    simpa [Function.comp_def, ev, e, b, coordinateActionCurve] using
      (coordinateEndomorphismEquiv_back_apply
        (rho (CompactRealForm.expSpecialUnitary (t • X))) v).symm
  · simpa [Function.comp_def, ev, e, b] using
      (coordinateEndomorphismEquiv_back_apply
        (show Module.End ℂ V from D.differential X) v).symm

/-- Every group-invariant finite-dimensional subspace is preserved by the
compact-real differential. -/
theorem differential_apply_mem
    {n : Type u} [Fintype n] [DecidableEq n]
    {V : Type v} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
    {rho : Representation ℂ (Matrix.specialUnitaryGroup n ℂ) V}
    (D : RealLieHomDerivativeAtIdentityAction rho)
    (S : Subrepresentation rho) (X : CompactRealForm n)
    {v : V} (hv : v ∈ S.toSubmodule) :
    (show Module.End ℂ V from D.differential X) v ∈ S.toSubmodule := by
  let : FiniteDimensional ℂ V := D.finiteDimensional
  have hDerivative := (D.orbit_derivative_at_zero X v).tendsto_slope_zero
  apply (Submodule.closed_of_finiteDimensional S.toSubmodule).mem_of_tendsto
    hDerivative
  filter_upwards with t
  apply S.toSubmodule.smul_mem
  apply S.toSubmodule.sub_mem
  · exact S.apply_mem_toSubmodule
      (CompactRealForm.expSpecialUnitary ((0 + t) • X)) hv
  · exact S.apply_mem_toSubmodule
      (CompactRealForm.expSpecialUnitary (0 • X)) hv

/-- Restrict the compact-real Lie differential algebraically to an invariant
subrepresentation. -/
def restrictedDifferential
    {n : Type u} [Fintype n] [DecidableEq n]
    {V : Type v} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
    {rho : Representation ℂ (Matrix.specialUnitaryGroup n ℂ) V}
    (D : RealLieHomDerivativeAtIdentityAction rho)
    (S : Subrepresentation rho) :
    CompactRealForm n →ₗ⁅ℝ⁆
      RestrictScalars ℝ ℂ (Module.End ℂ S.toSubmodule) := by
  letI : FiniteDimensional ℂ V := D.finiteDimensional
  let f : CompactRealForm n →ₗ[ℝ]
      RestrictScalars ℝ ℂ (Module.End ℂ S.toSubmodule) :=
    { toFun := fun X => LinearMap.restrict
        (show Module.End ℂ V from D.differential X)
        (fun v hv => D.differential_apply_mem S X hv)
      map_add' := by
        intro X Y
        apply LinearMap.ext
        intro v
        apply Subtype.ext
        exact congrArg (fun F : Module.End ℂ V => F v)
          (D.differential.map_add X Y)
      map_smul' := by
        intro r X
        apply LinearMap.ext
        intro v
        apply Subtype.ext
        exact congrArg (fun F : Module.End ℂ V => F v)
          (D.differential.map_smul r X) }
  refine LieHom.mk f ?_
  intro X Y
  apply LinearMap.ext
  intro v
  apply Subtype.ext
  change (show Module.End ℂ V from D.differential ⁅X, Y⁆) v = _
  rw [D.differential.map_lie]
  rfl

/-- In canonical coordinates, restrict an ambient operator to a subspace by
orthogonally projecting its output.  On operators preserving the subspace,
the projection is the genuine algebraic restriction. -/
def projectedCoordinateRestriction
    {V : Type v} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
    [FiniteDimensional ℂ V]
    (S : Submodule ℂ V) :
    (CoordinateSpace (V := V) →L[ℂ] CoordinateSpace (V := V)) →L[ℝ]
      (CoordinateSpace (V := S) →L[ℂ] CoordinateSpace (V := S)) := by
  let eV : V ≃L[ℂ] CoordinateSpace (V := V) :=
    (Module.Basis.ofVectorSpace ℂ V).equivFun.toContinuousLinearEquiv
  let eS : S ≃L[ℂ] CoordinateSpace (V := S) :=
    (Module.Basis.ofVectorSpace ℂ S).equivFun.toContinuousLinearEquiv
  let pre : CoordinateSpace (V := S) →L[ℂ] CoordinateSpace (V := V) :=
    eV.toContinuousLinearMap.comp
      (S.subtypeL.comp eS.symm.toContinuousLinearMap)
  let post : CoordinateSpace (V := V) →L[ℂ] CoordinateSpace (V := S) :=
    eS.toContinuousLinearMap.comp
      (S.orthogonalProjectionOnto.comp eV.symm.toContinuousLinearMap)
  exact (((ContinuousLinearMap.compL ℂ
    (CoordinateSpace (V := S)) (CoordinateSpace (V := V))
    (CoordinateSpace (V := S))) post).comp
      ((ContinuousLinearMap.compL ℂ
        (CoordinateSpace (V := S)) (CoordinateSpace (V := V))
        (CoordinateSpace (V := V))).flip pre)).restrictScalars ℝ

/-- The projected coordinate restriction is exact for every preserving
endomorphism. -/
theorem projectedCoordinateRestriction_apply
    {V : Type v} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
    [FiniteDimensional ℂ V]
    (S : Submodule ℂ V) (f : Module.End ℂ V)
    (hf : ∀ ⦃v : V⦄, v ∈ S → f v ∈ S) :
    projectedCoordinateRestriction S (coordinateEndomorphismEquiv f) =
      coordinateEndomorphismEquiv (LinearMap.restrict f hf) := by
  let eV : V ≃L[ℂ] CoordinateSpace (V := V) :=
    (Module.Basis.ofVectorSpace ℂ V).equivFun.toContinuousLinearEquiv
  let eS : S ≃L[ℂ] CoordinateSpace (V := S) :=
    (Module.Basis.ofVectorSpace ℂ S).equivFun.toContinuousLinearEquiv
  apply ContinuousLinearMap.ext
  intro x
  obtain ⟨v, rfl⟩ := eS.surjective x
  apply eS.symm.injective
  simp only [projectedCoordinateRestriction, ContinuousLinearMap.comp_apply,
    ContinuousLinearMap.coe_restrictScalars', ContinuousLinearMap.compL_apply,
    ContinuousLinearMap.flip_apply]
  change
    eS.symm
        (eS (S.orthogonalProjectionOnto
          (eV.symm (coordinateEndomorphismEquiv f
            (eV (S.subtypeL (eS.symm (eS v)))))))) =
      eS.symm
        (coordinateEndomorphismEquiv (LinearMap.restrict f hf) (eS v))
  rw [eS.symm_apply_apply, eS.symm_apply_apply]
  change
    S.orthogonalProjectionOnto
        ((Module.Basis.ofVectorSpace ℂ V).equivFun.symm
          (coordinateEndomorphismEquiv f
            ((Module.Basis.ofVectorSpace ℂ V).equivFun (v : V)))) =
      (Module.Basis.ofVectorSpace ℂ S).equivFun.symm
        (coordinateEndomorphismEquiv (LinearMap.restrict f hf)
          ((Module.Basis.ofVectorSpace ℂ S).equivFun v))
  rw [coordinateEndomorphismEquiv_back_apply,
    coordinateEndomorphismEquiv_back_apply]
  exact S.orthogonalProjectionOnto_mem_subspace_eq_self
    ⟨f v, hf v.property⟩

/-- The projected restriction transports the pinned real derivative used for
operator algebras.  The explicit normed instances agree with the definition
of `HasRealDerivAt` and avoid an ambiguous typeclass path through complex
operator spaces. -/
theorem projectedCoordinateRestriction_hasRealDerivAt
    {V : Type v} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
    [FiniteDimensional ℂ V]
    (S : Submodule ℂ V)
    {f : ℝ →
      (CoordinateSpace (V := V) →L[ℂ] CoordinateSpace (V := V))}
    {D : CoordinateSpace (V := V) →L[ℂ] CoordinateSpace (V := V)}
    {t : ℝ} (h : HasRealDerivAt f D t) :
    HasRealDerivAt
      (fun s => projectedCoordinateRestriction S (f s))
      (projectedCoordinateRestriction S D) t := by
  let A := CoordinateSpace (V := V) →L[ℂ] CoordinateSpace (V := V)
  let B := CoordinateSpace (V := S) →L[ℂ] CoordinateSpace (V := S)
  let hNormedAddA : NormedAddCommGroup A :=
    NonUnitalNormedRing.toNormedAddCommGroup
  let : AddCommGroup A := hNormedAddA.toAddCommGroup
  let : NormedSpace ℝ A := NormedAlgebra.toNormedSpace A
  let hNormedAddB : NormedAddCommGroup B :=
    NonUnitalNormedRing.toNormedAddCommGroup
  let : AddCommGroup B := hNormedAddB.toAddCommGroup
  let : NormedSpace ℝ B := NormedAlgebra.toNormedSpace B
  change HasDerivAt f D t at h
  change HasDerivAt
    (fun s => projectedCoordinateRestriction S (f s))
    (projectedCoordinateRestriction S D) t
  let T : A →L[ℝ] B :=
    { toFun := fun x => projectedCoordinateRestriction S x
      map_add' := fun x y =>
        (projectedCoordinateRestriction S).map_add x y
      map_smul' := fun r x =>
        (projectedCoordinateRestriction S).map_smul r x
      cont := (projectedCoordinateRestriction S).continuous }
  exact T.hasFDerivAt.comp_hasDerivAt t h

/-- An ambient compact-real derivative certificate descends canonically to
every invariant subrepresentation. -/
def restrictToSubrepresentation
    {n : Type u} [Fintype n] [DecidableEq n]
    {V : Type v} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
    {rho : Representation ℂ (Matrix.specialUnitaryGroup n ℂ) V}
    (D : RealLieHomDerivativeAtIdentityAction rho)
    (S : Subrepresentation rho) :
    RealLieHomDerivativeAtIdentityAction S.toRepresentation := by
  letI : FiniteDimensional ℂ V := D.finiteDimensional
  refine
    { differential := D.restrictedDifferential S
      derivative_at_zero := fun X => ?_ }
  have hDerivative := projectedCoordinateRestriction_hasRealDerivAt
    S.toSubmodule (D.derivative_at_zero X)
  convert hDerivative using 1
  · funext t
    simp only [coordinateActionCurve]
    rw [projectedCoordinateRestriction_apply S.toSubmodule
      (rho (CompactRealForm.expSpecialUnitary (t • X)))
      (fun _v hv => S.apply_mem_toSubmodule _ hv)]
    rfl
  · change coordinateEndomorphismEquiv
        (show Module.End ℂ S.toSubmodule from D.restrictedDifferential S X) =
      projectedCoordinateRestriction S.toSubmodule
        (coordinateEndomorphismEquiv
          (show Module.End ℂ V from D.differential X))
    rw [projectedCoordinateRestriction_apply S.toSubmodule
      (show Module.End ℂ V from D.differential X)
      (fun _v hv => D.differential_apply_mem S X hv)]
    rfl

/-- Complexifying the compact real differential produces the intrinsic
`sl(n,C)` differential used by the existing semisimple embedding classification integration chain. -/
def toLieHomDerivativeAtIdentityAction
    {n : Type u} [Fintype n] [DecidableEq n]
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    {rho : Representation ℂ (Matrix.specialUnitaryGroup n ℂ) V}
    (D : RealLieHomDerivativeAtIdentityAction rho) :
    LieHomDerivativeAtIdentityAction rho
      (CompactRealForm.toSpecialLinear : CompactRealForm n →
        LieAlgebra.SpecialLinear.sl n ℂ) := by
  letI : FiniteDimensional ℂ V := D.finiteDimensional
  exact
    { differential := CompactRealForm.complexifyRealLieHom D.differential
      derivative_at_zero := fun X => by
        rw [CompactRealForm.complexifyRealLieHom_compact]
        exact D.derivative_at_zero X }

end RealLieHomDerivativeAtIdentityAction

/-!
## Deriving the Lie law from a linear identity differential

For an actual differentiable representation, preservation of the Lie bracket
is not independent input.  It follows by differentiating the conjugation
identity twice: first along the represented one-parameter subgroup and then
along the conjugating subgroup.
-/

/-- A real-linear candidate for the identity differential, with its actual
one-parameter derivative identity but without an assumed bracket law. -/
structure RealLinearDerivativeAtIdentityAction
    {n : Type u} [Fintype n] [DecidableEq n]
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    (rho : Representation ℂ (Matrix.specialUnitaryGroup n ℂ) V) where
  [finiteDimensional : FiniteDimensional ℂ V]
  differential : CompactRealForm n →ₗ[ℝ]
    RestrictScalars ℝ ℂ (Module.End ℂ V)
  derivative_at_zero : ∀ X : CompactRealForm n,
    HasRealDerivAt (coordinateActionCurve rho X)
      (coordinateEndomorphismEquiv (differential X)) 0

namespace RealLinearDerivativeAtIdentityAction

variable {n : Type u} [Fintype n] [DecidableEq n]
variable {V : Type v} [AddCommGroup V] [Module ℂ V]
variable [FiniteDimensional ℂ V]
variable {rho : Representation ℂ (Matrix.specialUnitaryGroup n ℂ) V}

/-- Coordinate transport turns the candidate differential into a real-linear
map between canonical normed spaces. -/
def coordinateDifferential
    (D : RealLinearDerivativeAtIdentityAction rho) :
    CompactRealForm n →ₗ[ℝ]
      (CoordinateSpace (V := V) →L[ℂ] CoordinateSpace (V := V)) :=
  { toFun := fun X => coordinateEndomorphismEquiv (D.differential X)
    map_add' := by
      intro X Y
      rw [D.differential.map_add]
      exact map_add _ _ _
    map_smul' := by
      intro r X
      rw [D.differential.map_smul]
      change coordinateEndomorphismEquiv
          ((r : ℂ) • (show Module.End ℂ V from D.differential X)) =
        (r : ℂ) • coordinateEndomorphismEquiv
          (show Module.End ℂ V from D.differential X)
      exact map_smul _ _ _ }

@[simp]
theorem coordinateDifferential_apply
    (D : RealLinearDerivativeAtIdentityAction rho)
    (X : CompactRealForm n) :
    D.coordinateDifferential X =
      coordinateEndomorphismEquiv (D.differential X) := rfl

/-- Differentiating the representation identity for a conjugated
one-parameter subgroup makes the candidate differential equivariant under
special-unitary conjugation. -/
theorem coordinateDifferential_conjugate
    (D : RealLinearDerivativeAtIdentityAction rho)
    (g : Matrix.specialUnitaryGroup n ℂ)
    (Y : CompactRealForm n) :
    D.coordinateDifferential (CompactRealForm.conjugate g Y) =
      coordinateEndomorphismEquiv (rho g) * D.coordinateDifferential Y *
        coordinateEndomorphismEquiv (rho g⁻¹) := by
  let A := CoordinateSpace (V := V) →L[ℂ] CoordinateSpace (V := V)
  let hNormedAddA : NormedAddCommGroup A :=
    NonUnitalNormedRing.toNormedAddCommGroup
  let : AddCommGroup A := hNormedAddA.toAddCommGroup
  let : NormedSpace ℝ A := NormedAlgebra.toNormedSpace A
  have hLeft := D.derivative_at_zero (CompactRealForm.conjugate g Y)
  have hMiddle := D.derivative_at_zero Y
  change HasDerivAt (coordinateActionCurve rho
    (CompactRealForm.conjugate g Y))
      (D.coordinateDifferential (CompactRealForm.conjugate g Y)) 0 at hLeft
  change HasDerivAt (coordinateActionCurve rho Y)
      (D.coordinateDifferential Y) 0 at hMiddle
  have hRight :=
    (hMiddle.const_mul (coordinateEndomorphismEquiv (rho g))).mul_const
      (coordinateEndomorphismEquiv (rho g⁻¹))
  have hCurve :
      coordinateActionCurve rho (CompactRealForm.conjugate g Y) =
        fun s => coordinateEndomorphismEquiv (rho g) *
          coordinateActionCurve rho Y s *
            coordinateEndomorphismEquiv (rho g⁻¹) := by
    funext s
    simp only [coordinateActionCurve,
      CompactRealForm.expSpecialUnitary_smul_conjugate, map_mul]
  rw [hCurve] at hLeft
  exact hLeft.unique hRight

/-- A real-linear identity differential that differentiates every compact
one-parameter subgroup necessarily preserves the Lie bracket. -/
theorem coordinateDifferential_map_lie
    (D : RealLinearDerivativeAtIdentityAction rho)
    (X Y : CompactRealForm n) :
    D.coordinateDifferential ⁅X, Y⁆ =
      D.coordinateDifferential X * D.coordinateDifferential Y -
        D.coordinateDifferential Y * D.coordinateDifferential X := by
  let A := CoordinateSpace (V := V) →L[ℂ] CoordinateSpace (V := V)
  let hNormedAddA : NormedAddCommGroup A :=
    NonUnitalNormedRing.toNormedAddCommGroup
  let : AddCommGroup A := hNormedAddA.toAddCommGroup
  let : NormedSpace ℝ A := NormedAlgebra.toNormedSpace A
  let C : CompactRealForm n →L[ℝ] A :=
    D.coordinateDifferential.toContinuousLinearMap
  have hLeft := C.hasFDerivAt.comp_hasDerivAt 0
    (CompactRealForm.conjugate_exp_hasDerivAt X Y)
  change HasDerivAt
    (fun t : ℝ => C (CompactRealForm.conjugate
      (CompactRealForm.expSpecialUnitary (t • X)) Y))
    (D.coordinateDifferential ⁅X, Y⁆) 0 at hLeft
  have hPos := D.derivative_at_zero X
  have hNeg := D.derivative_at_zero (-X)
  change HasDerivAt (coordinateActionCurve rho X)
      (D.coordinateDifferential X) 0 at hPos
  change HasDerivAt (coordinateActionCurve rho (-X))
      (D.coordinateDifferential (-X)) 0 at hNeg
  have hRight :=
    (hPos.mul_const (D.coordinateDifferential Y)).mul hNeg
  have hCurve :
      (fun t : ℝ => C
        (CompactRealForm.conjugate
          (CompactRealForm.expSpecialUnitary (t • X)) Y)) =
        fun t => coordinateActionCurve rho X t *
          D.coordinateDifferential Y * coordinateActionCurve rho (-X) t := by
    funext t
    change D.coordinateDifferential
      (CompactRealForm.conjugate
        (CompactRealForm.expSpecialUnitary (t • X)) Y) = _
    rw [coordinateDifferential_conjugate D
      (CompactRealForm.expSpecialUnitary (t • X)) Y]
    simp only [coordinateActionCurve,
      CompactRealForm.expSpecialUnitary_real_smul_neg]
  rw [hCurve] at hLeft
  have hDerivative := hLeft.unique hRight
  have hNegDiff :
      D.coordinateDifferential (-X) = -D.coordinateDifferential X :=
    D.coordinateDifferential.map_neg X
  rw [hNegDiff] at hDerivative
  simp only [coordinateActionCurve_zero, mul_one, one_mul] at hDerivative
  apply ContinuousLinearMap.ext
  intro v
  have hApply := congrArg (fun T : A => T v) hDerivative
  simpa [sub_eq_add_neg] using hApply

/-- Package the derived bracket law as the intrinsic real Lie homomorphism
used by the existing semisimple embedding classification bridge. -/
def toRealLieHomDerivativeAtIdentityAction
    (D : RealLinearDerivativeAtIdentityAction rho) :
    RealLieHomDerivativeAtIdentityAction rho := by
  letI : FiniteDimensional ℂ V := D.finiteDimensional
  let f : CompactRealForm n →ₗ[ℝ]
      RestrictScalars ℝ ℂ (Module.End ℂ V) :=
    { toFun := D.differential
      map_add' := by
        intro X Y
        exact D.differential.map_add X Y
      map_smul' := by
        intro r X
        exact D.differential.map_smul r X }
  refine
    { differential := LieHom.mk f ?_
      derivative_at_zero := D.derivative_at_zero }
  intro X Y
  apply coordinateEndomorphismEquiv.injective
  change D.coordinateDifferential ⁅X, Y⁆ =
    coordinateEndomorphismEquiv
      ((show Module.End ℂ V from D.differential X) *
          (show Module.End ℂ V from D.differential Y) -
        (show Module.End ℂ V from D.differential Y) *
          (show Module.End ℂ V from D.differential X))
  rw [D.coordinateDifferential_map_lie X Y]
  rw [map_sub, map_mul, map_mul]
  change
    coordinateEndomorphismEquiv
          (show Module.End ℂ V from D.differential X) *
        coordinateEndomorphismEquiv
          (show Module.End ℂ V from D.differential Y) -
      coordinateEndomorphismEquiv
          (show Module.End ℂ V from D.differential Y) *
        coordinateEndomorphismEquiv
          (show Module.End ℂ V from D.differential X) = _
  rfl

end RealLinearDerivativeAtIdentityAction

/-!
## Standard `SU(2)` and `SU(3)` certificates
-/

/-- An `SU(2)` Lie action identified with the derivative at zero of the
actual group action along every compact one-parameter subgroup. -/
structure SU2DerivativeAtIdentityAction
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    (rho : Representation ℂ SU2 V) where
  [finiteDimensional : FiniteDimensional ℂ V]
  [lieRingModule : LieRingModule StandardSl2.Algebra V]
  [lieModule : LieModule ℂ StandardSl2.Algebra V]
  derivative_at_zero : ∀ X : CompactRealForm (Fin 2),
    HasRealDerivAt (coordinateActionCurve rho X)
      (coordinateEndomorphismEquiv
        (LieModule.toEnd ℂ StandardSl2.Algebra V X.toSpecialLinear)) 0

namespace SU2DerivativeAtIdentityAction

/-- The one-parameter subgroup theorem supplies the formerly assumed
exponential compatibility field. -/
def toDifferentiatedExponentialAction
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    {rho : Representation ℂ SU2 V}
    (D : SU2DerivativeAtIdentityAction rho) :
    SpecialUnitaryLieAlgebra.SU2DifferentiatedExponentialAction rho := by
  letI : FiniteDimensional ℂ V := D.finiteDimensional
  letI : LieRingModule StandardSl2.Algebra V := D.lieRingModule
  letI : LieModule ℂ StandardSl2.Algebra V := D.lieModule
  exact
    { action_exp := action_exp_of_hasRealDerivAt_zero rho
        CompactRealForm.toSpecialLinear D.derivative_at_zero }

/-- Directly reach the generated model used by semisimple embedding classification. -/
def toGeneratedModelOfCompactGeneration
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    {rho : Representation ℂ SU2 V}
    (D : SU2DerivativeAtIdentityAction rho) :
    HighestWeightBridge.SU2GeneratedExponentialStandardLieModel rho :=
  D.toDifferentiatedExponentialAction.toGeneratedModelOfCompactGeneration

end SU2DerivativeAtIdentityAction

/-- The analogous derivative-at-identity certificate for `SU(3)`. -/
structure SU3DerivativeAtIdentityAction
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    (rho : Representation ℂ SU3 V) where
  [finiteDimensional : FiniteDimensional ℂ V]
  [lieRingModule : LieRingModule StandardSl3.Algebra V]
  [lieModule : LieModule ℂ StandardSl3.Algebra V]
  derivative_at_zero : ∀ X : CompactRealForm (Fin 3),
    HasRealDerivAt (coordinateActionCurve rho X)
      (coordinateEndomorphismEquiv
        (LieModule.toEnd ℂ StandardSl3.Algebra V X.toSpecialLinear)) 0

namespace SU3DerivativeAtIdentityAction

def toDifferentiatedExponentialAction
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    {rho : Representation ℂ SU3 V}
    (D : SU3DerivativeAtIdentityAction rho) :
    SpecialUnitaryLieAlgebra.SU3DifferentiatedExponentialAction rho := by
  letI : FiniteDimensional ℂ V := D.finiteDimensional
  letI : LieRingModule StandardSl3.Algebra V := D.lieRingModule
  letI : LieModule ℂ StandardSl3.Algebra V := D.lieModule
  exact
    { action_exp := action_exp_of_hasRealDerivAt_zero rho
        CompactRealForm.toSpecialLinear D.derivative_at_zero }

/-- Directly reach the exponential model used by semisimple embedding classification. -/
def toExponentialModelOfCompactGeneration
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    {rho : Representation ℂ SU3 V}
    (D : SU3DerivativeAtIdentityAction rho) :
    HighestWeightBridge.SU3ExponentiallyIntegratedStandardLieModel rho :=
  D.toDifferentiatedExponentialAction.toExponentialModelOfCompactGeneration

end SU3DerivativeAtIdentityAction

/-!
## Standard certificates from intrinsic differentials
-/

/-- The intrinsic differential certificate specialized to `SU(2)`. -/
abbrev SU2LieHomDerivativeAtIdentityAction
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    (rho : Representation ℂ SU2 V) :=
  LieHomDerivativeAtIdentityAction rho CompactRealForm.toSpecialLinear

namespace SU2LieHomDerivativeAtIdentityAction

/-- A complex Lie-hom differential canonically supplies the standard
`sl₂(ℂ)` Lie-module structure expected by the integration bridge. -/
def toDerivativeAtIdentityAction
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    {rho : Representation ℂ SU2 V}
    (D : SU2LieHomDerivativeAtIdentityAction rho) :
    SU2DerivativeAtIdentityAction rho := by
  letI : FiniteDimensional ℂ V := D.finiteDimensional
  letI : LieRingModule StandardSl2.Algebra V := D.lieRingModule
  letI : LieModule ℂ StandardSl2.Algebra V := D.lieModule
  exact
    { derivative_at_zero := fun X => by
        rw [D.toEnd_eq_differential]
        exact D.derivative_at_zero X }

end SU2LieHomDerivativeAtIdentityAction

/-- The intrinsic differential certificate specialized to `SU(3)`. -/
abbrev SU3LieHomDerivativeAtIdentityAction
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    (rho : Representation ℂ SU3 V) :=
  LieHomDerivativeAtIdentityAction rho CompactRealForm.toSpecialLinear

namespace SU3LieHomDerivativeAtIdentityAction

/-- A complex Lie-hom differential canonically supplies the standard
`sl₃(ℂ)` Lie-module structure expected by the integration bridge. -/
def toDerivativeAtIdentityAction
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    {rho : Representation ℂ SU3 V}
    (D : SU3LieHomDerivativeAtIdentityAction rho) :
    SU3DerivativeAtIdentityAction rho := by
  letI : FiniteDimensional ℂ V := D.finiteDimensional
  letI : LieRingModule StandardSl3.Algebra V := D.lieRingModule
  letI : LieModule ℂ StandardSl3.Algebra V := D.lieModule
  exact
    { derivative_at_zero := fun X => by
        rw [D.toEnd_eq_differential]
        exact D.derivative_at_zero X }

end SU3LieHomDerivativeAtIdentityAction

/-!
## Standard certificates from compact-real differentials
-/

/-- A real-linear `su(2)` differential whose one-parameter derivatives agree
with the actual representation.  Bracket preservation is derived, not stored. -/
abbrev SU2RealLinearDerivativeAtIdentityAction
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    (rho : Representation ℂ SU2 V) :=
  RealLinearDerivativeAtIdentityAction rho

namespace SU2RealLinearDerivativeAtIdentityAction

def toRealLieHomDerivativeAtIdentityAction
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    {rho : Representation ℂ SU2 V}
    (D : SU2RealLinearDerivativeAtIdentityAction rho) :
    RealLieHomDerivativeAtIdentityAction rho :=
  RealLinearDerivativeAtIdentityAction.toRealLieHomDerivativeAtIdentityAction D

end SU2RealLinearDerivativeAtIdentityAction

/-- The analogous real-linear identity differential for `SU(3)`. -/
abbrev SU3RealLinearDerivativeAtIdentityAction
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    (rho : Representation ℂ SU3 V) :=
  RealLinearDerivativeAtIdentityAction rho

namespace SU3RealLinearDerivativeAtIdentityAction

def toRealLieHomDerivativeAtIdentityAction
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    {rho : Representation ℂ SU3 V}
    (D : SU3RealLinearDerivativeAtIdentityAction rho) :
    RealLieHomDerivativeAtIdentityAction rho :=
  RealLinearDerivativeAtIdentityAction.toRealLieHomDerivativeAtIdentityAction D

end SU3RealLinearDerivativeAtIdentityAction

/-- The naturally real `su(2)` differential of an actual representation. -/
abbrev SU2RealLieHomDerivativeAtIdentityAction
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    (rho : Representation ℂ SU2 V) :=
  RealLieHomDerivativeAtIdentityAction rho

namespace SU2RealLieHomDerivativeAtIdentityAction

def toLieHomDerivativeAtIdentityAction
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    {rho : Representation ℂ SU2 V}
    (D : SU2RealLieHomDerivativeAtIdentityAction rho) :
    SU2LieHomDerivativeAtIdentityAction rho :=
  RealLieHomDerivativeAtIdentityAction.toLieHomDerivativeAtIdentityAction D

/-- Reach the generated standard `sl₂` model directly from the compact-real
differential of this one representation. -/
def toGeneratedModelOfCompactGeneration
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    {rho : Representation ℂ SU2 V}
    (D : SU2RealLieHomDerivativeAtIdentityAction rho) :
    HighestWeightBridge.SU2GeneratedExponentialStandardLieModel rho :=
  D.toLieHomDerivativeAtIdentityAction.toDerivativeAtIdentityAction
    |>.toGeneratedModelOfCompactGeneration

end SU2RealLieHomDerivativeAtIdentityAction

/-- The naturally real `su(3)` differential of an actual representation. -/
abbrev SU3RealLieHomDerivativeAtIdentityAction
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    (rho : Representation ℂ SU3 V) :=
  RealLieHomDerivativeAtIdentityAction rho

namespace SU3RealLieHomDerivativeAtIdentityAction

def toLieHomDerivativeAtIdentityAction
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    {rho : Representation ℂ SU3 V}
    (D : SU3RealLieHomDerivativeAtIdentityAction rho) :
    SU3LieHomDerivativeAtIdentityAction rho :=
  RealLieHomDerivativeAtIdentityAction.toLieHomDerivativeAtIdentityAction D

/-- Reach the exponentially integrated standard `sl₃` model directly from
the compact-real differential of this one representation. -/
def toExponentialModelOfCompactGeneration
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    {rho : Representation ℂ SU3 V}
    (D : SU3RealLieHomDerivativeAtIdentityAction rho) :
    HighestWeightBridge.SU3ExponentiallyIntegratedStandardLieModel rho :=
  D.toLieHomDerivativeAtIdentityAction.toDerivativeAtIdentityAction
    |>.toExponentialModelOfCompactGeneration

end SU3RealLieHomDerivativeAtIdentityAction

