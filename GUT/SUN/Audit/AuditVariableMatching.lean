import GUT.SUN.Matching.Controls
import Lean.Util.CollectAxioms

run_cmd do
  let declarations := [
    ``GUT.SUN.DiagonalBackground.Background.matrix_trace,
    ``GUT.SUN.DiagonalBackground.Background.matrix_hermitian,
    ``GUT.SUN.DiagonalBackground.Background.effectiveV_ne_zero,
