    ``GUT.SUN.DiagonalBackground.Background.massSquared_pos,
    ``GUT.SUN.DiagonalBackground.Background.massSquared_ne_zero,
    ``GUT.SUN.DiagonalBackground.Background.core_mass,
    ``GUT.SUN.DiagonalBackground.Background.equal_weight_entry_zero,
    ``GUT.SUN.ExteriorMatter.matrixHom_unitary,
    ``GUT.SUN.ExteriorMatter.matrixHom_det,
    ``GUT.SUN.ExteriorMatter.cut_matrixHom,
    ``GUT.SUN.ExteriorMatter.inclusion_injective,
    ``GUT.SUN.ExteriorMatter.fundamental_include,
    ``GUT.SUN.ExteriorMatter.matter_embed,
    ``GUT.SUN.ExteriorMatter.retained_branch,
