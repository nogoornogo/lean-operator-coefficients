    ``Math.JetInputAdapter.values,
    ``Math.JetInputAdapter.Input,
    ``Math.JetInputAdapter.legacyInputEquiv,
    ``Math.JetInputAdapter.equiv,
    ``Math.JetInputAdapter.extraction,
    ``Math.JetInputAdapter.reconstruction,
