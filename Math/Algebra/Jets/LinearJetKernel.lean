import Math.Algebra.Jets.LinearJetAlgebra
import Math.RepresentationTheory.Jets.JetFunctor
import Mathlib.RingTheory.TwoSidedIdeal.Operations
import Mathlib.RingTheory.TwoSidedIdeal.Kernel
import Mathlib.RingTheory.Congruence.Hom
import Mathlib.Algebra.Module.Projective

/-! The actual mixed EOM kernel is generated by the linear relations. -/
namespace Math.LinearJetAlgebra
set_option autoImplicit false
noncomputable section
open JetLinear JetDirections LinearJetEquation
open scoped TensorProduct
variable {F B I EF EB : Type*} [AddCommGroup EF] [Module ℂ EF]
  [AddCommGroup EB] [Module ℂ EB]
  (eF : EF →ₗ[ℂ] Jet F I) (eB : EB →ₗ[ℂ] Jet B I)

def relationIdeal : TwoSidedIdeal (MixedJetAlgebra.Algebra F B I) :=
  TwoSidedIdeal.span ((JetFunctor.oddVector (B := B) '' (relations eF : Set (Jet F I))) ∪
    (JetFunctor.evenVector (F := F) '' (relations eB : Set (Jet B I))))

private def split {S E : Type*} [AddCommGroup E] [Module ℂ E] (e : E →ₗ[ℂ] Jet S I) :
    Generator e →ₗ[ℂ] Jet S I :=
  Classical.choose ((relations e).mkQ.exists_rightInverse_of_surjective (LinearMap.range_eq_top.mpr (relations e).mkQ_surjective))

private theorem split_spec {S E : Type*} [AddCommGroup E] [Module ℂ E]
    (e : E →ₗ[ℂ] Jet S I) (v : Generator e) : (relations e).mkQ (split e v) = v :=
  LinearMap.congr_fun (Classical.choose_spec
    ((relations e).mkQ.exists_rightInverse_of_surjective (LinearMap.range_eq_top.mpr (relations e).mkQ_surjective))) v

private def reconstruct : Algebra eF eB →ₐ[ℂ] MixedJetAlgebra.Algebra F B I :=
  Algebra.TensorProduct.map (ExteriorAlgebra.map (split eF))
    (SymmetricAlgebra.lift (JetLinear.linearForm.comp (split eB)))

private def q := (relationIdeal eF eB).ringCon.mkₐ (α := ℂ)

private theorem q_odd (v : Jet F I) :
    q eF eB (JetFunctor.oddVector (B := B) (split eF ((relations eF).mkQ v))) =
      q eF eB (JetFunctor.oddVector (B := B) v) := by
  apply Quotient.sound
  apply (TwoSidedIdeal.rel_iff _ _ _).mpr
  rw [← map_sub]
  apply TwoSidedIdeal.subset_span
  apply Or.inl
  refine ⟨_, ?_, rfl⟩
  apply (Submodule.Quotient.mk_eq_zero _).mp
  change (relations eF).mkQ (_ - _) = 0
  rw [map_sub, split_spec, sub_self]

private theorem q_even (v : Jet B I) :
    q eF eB (JetFunctor.evenVector (F := F) (split eB ((relations eB).mkQ v))) =
      q eF eB (JetFunctor.evenVector (F := F) v) := by
  apply Quotient.sound
  apply (TwoSidedIdeal.rel_iff _ _ _).mpr
  rw [← map_sub]
  apply TwoSidedIdeal.subset_span
  apply Or.inr
  refine ⟨_, ?_, rfl⟩
  apply (Submodule.Quotient.mk_eq_zero _).mp
  change (relations eB).mkQ (_ - _) = 0
  rw [map_sub, split_spec, sub_self]

private theorem q_reconstruct (x : MixedJetAlgebra.Algebra F B I) :
    q eF eB (reconstruct eF eB (projection eF eB x)) = q eF eB x := by
  let f := (q eF eB).comp ((reconstruct eF eB).comp (projection eF eB))
  have ho : f.comp Algebra.TensorProduct.includeLeft =
      (q eF eB).comp Algebra.TensorProduct.includeLeft := by
    apply ExteriorAlgebra.hom_ext
    apply LinearMap.ext
    intro v
    change q eF eB (reconstruct eF eB (projection eF eB
      (ExteriorAlgebra.ι ℂ v ⊗ₜ[ℂ] 1))) = q eF eB (ExteriorAlgebra.ι ℂ v ⊗ₜ[ℂ] 1)
    simp only [projection_tmul, oddProjection_ι, map_one, reconstruct,
      Algebra.TensorProduct.map_tmul, ExteriorAlgebra.map_apply_ι]
    exact q_odd eF eB v
  have he : f.comp Algebra.TensorProduct.includeRight =
      (q eF eB).comp Algebra.TensorProduct.includeRight := by
    apply MvPolynomial.algHom_ext
    intro j
    change q eF eB (reconstruct eF eB (projection eF eB
      (1 ⊗ₜ[ℂ] MvPolynomial.X j))) = q eF eB (1 ⊗ₜ[ℂ] MvPolynomial.X j)
    simp only [projection_tmul, evenProjection_X, map_one, reconstruct,
      Algebra.TensorProduct.map_tmul, SymmetricAlgebra.lift_ι_apply, LinearMap.comp_apply]
    simpa [JetFunctor.evenVector, JetLinear.linearForm] using q_even eF eB (Finsupp.single j 1)
  have hh : f = q eF eB := Algebra.TensorProduct.ext ho he
  exact AlgHom.congr_fun hh x

theorem relationIdeal_le_kernel : relationIdeal eF eB ≤ TwoSidedIdeal.ker (projection eF eB) := by
  apply TwoSidedIdeal.span_le.mpr
  rintro x (⟨v, hv, rfl⟩ | ⟨v, hv, rfl⟩)
  · change _ ∈ TwoSidedIdeal.ker (projection eF eB)
    rw [TwoSidedIdeal.mem_ker]
    change oddProjection eF (ExteriorAlgebra.ι ℂ v) ⊗ₜ[ℂ] evenProjection eB 1 = 0
    rw [oddProjection_ι, show (relations eF).mkQ v = 0 from (Submodule.Quotient.mk_eq_zero _).mpr hv, map_zero, TensorProduct.zero_tmul]
  · change _ ∈ TwoSidedIdeal.ker (projection eF eB)
    rw [TwoSidedIdeal.mem_ker]
    change oddProjection eF 1 ⊗ₜ[ℂ] evenProjection eB (JetLinear.linearForm v) = 0
    rw [evenProjection_linearForm, show (relations eB).mkQ v = 0 from (Submodule.Quotient.mk_eq_zero _).mpr hv, map_zero, TensorProduct.tmul_zero]

theorem kernel_eq_relationIdeal : TwoSidedIdeal.ker (projection eF eB) = relationIdeal eF eB := by
  apply le_antisymm _ (relationIdeal_le_kernel eF eB)
  intro x hx
  rw [TwoSidedIdeal.mem_ker] at hx
  have he := q_reconstruct eF eB x
  rw [hx, map_zero, map_zero] at he
  apply (TwoSidedIdeal.mem_iff _ _).mpr
  apply Quotient.exact
  exact he.symm

def descendantIdeal : TwoSidedIdeal (MixedJetAlgebra.Algebra F B I) :=
  TwoSidedIdeal.span ({x | ∃ p v, JetFunctor.oddVector (B := B) (multiple p (eF v)) = x} ∪
    {x | ∃ p v, JetFunctor.evenVector (F := F) (multiple p (eB v)) = x})

theorem descendantIdeal_eq : descendantIdeal eF eB = relationIdeal eF eB := by
  apply le_antisymm
  · apply TwoSidedIdeal.span_le.mpr
    rintro x (⟨p, v, rfl⟩ | ⟨p, v, rfl⟩)
    · exact TwoSidedIdeal.subset_span (Or.inl ⟨_, descendant_mem eF p v, rfl⟩)
    · exact TwoSidedIdeal.subset_span (Or.inr ⟨_, descendant_mem eB p v, rfl⟩)
  · apply TwoSidedIdeal.span_le.mpr
    rintro x (⟨v, hv, rfl⟩ | ⟨v, hv, rfl⟩)
    · induction hv using Submodule.span_induction with
      | mem v hv => obtain ⟨p, w, rfl⟩ := hv; exact TwoSidedIdeal.subset_span (Or.inl ⟨p, w, rfl⟩)
      | zero => simp
      | add v w _ _ hv hw =>
        change _ ∈ descendantIdeal eF eB
        simpa only [map_add] using (descendantIdeal eF eB).add_mem hv hw
      | smul c v _ hv =>
        change _ ∈ descendantIdeal eF eB
        rw [map_smul]
        exact ((descendantIdeal eF eB).asIdeal.restrictScalars ℂ).smul_mem c hv
    · induction hv using Submodule.span_induction with
      | mem v hv => obtain ⟨p, w, rfl⟩ := hv; exact TwoSidedIdeal.subset_span (Or.inr ⟨p, w, rfl⟩)
      | zero => simp
      | add v w _ _ hv hw =>
        change _ ∈ descendantIdeal eF eB
        simpa only [map_add] using (descendantIdeal eF eB).add_mem hv hw
      | smul c v _ hv =>
        change _ ∈ descendantIdeal eF eB
        rw [map_smul]
        exact ((descendantIdeal eF eB).asIdeal.restrictScalars ℂ).smul_mem c hv

theorem kernel_eq_descendantIdeal : TwoSidedIdeal.ker (projection eF eB) = descendantIdeal eF eB := by
  rw [kernel_eq_relationIdeal, descendantIdeal_eq]

end
end Math.LinearJetAlgebra
