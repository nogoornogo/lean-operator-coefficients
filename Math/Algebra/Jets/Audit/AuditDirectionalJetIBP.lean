    ``Math.JetDirections.jetMap,
    ``Math.JetDirections.jetMap_id,
    ``Math.JetDirections.jetMap_comp,
    ``Math.JetDirections.jetAction,
    ``Math.JetDirections.shift_ofSymbols,
    ``Math.JetDirections.shiftVector,
