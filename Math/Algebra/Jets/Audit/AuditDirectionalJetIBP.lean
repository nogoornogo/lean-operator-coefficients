    ``Math.JetDirections.symbolPower_natural,
    ``Math.JetDirections.jetOrder,
    ``Math.JetDirections.ofSymbols_mem,
    ``Math.JetDirections.jetMap_order,
    ``Math.JetDirections.shear,
    ``Math.JetDirections.shear_order_two,
    ``Math.JetDirections.presentation,
    ``Math.JetDirections.presentation_ofSymbols,
    ``Math.JetDirections.ofSymbols_injective,
    ``Math.JetDirections.orderEmbedding,
    ``Math.JetDirections.orderEmbedding_injective,
    ``Math.JetDirections.orderEmbedding_mem,
    ``Math.JetDirections.orderEmbedding_natural,
    ``Math.JetDirections.attach,
