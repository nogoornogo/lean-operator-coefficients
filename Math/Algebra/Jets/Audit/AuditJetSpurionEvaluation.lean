import Math.Algebra.Jets.MixedJetSpurionExample

/-! Strict transitive audit of actual jet/spurion connections. -/
open Lean in
run_cmd do
  let env ← getEnv
  for mod in env.header.moduleNames do
    if (`Physics).isPrefixOf mod || (`GUT).isPrefixOf mod then
      throwError "Unexpected source layer {mod}; original {SourceLayout.originalModule mod}"
  let ds := [
    ``Math.LocalSpurionEvaluation.localAction,
    ``Math.LocalSpurionEvaluation.residualAction,
    ``Math.LocalSpurionEvaluation.commute,
    ``Math.LocalSpurionEvaluation.relations,
    ``Math.LocalSpurionEvaluation.Quotient,
    ``Math.LocalSpurionEvaluation.quotientAction,
    ``Math.LocalSpurionEvaluation.Coefficients,
    ``Math.LocalSpurionEvaluation.coefficientEquiv,
    ``Math.LocalSpurionEvaluation.coefficientEquiv_mk,
    ``Math.LocalSpurionEvaluation.coefficientEquiv_symm_apply,
    ``Math.LocalSpurionEvaluation.coordinates,
    ``Math.LocalSpurionEvaluation.dualAction,
    ``Math.LocalSpurionEvaluation.evaluation,
    ``Math.LocalSpurionEvaluation.evaluation_apply,
    ``Math.LocalSpurionEvaluation.evaluation_surjective,
    ``Math.LocalSpurionEvaluation.card_evaluation_surjective,
    ``Math.LocalSpurionEvaluation.nonzero_iff,
    ``Math.LocalSpurionEvaluation.forbidden_iff,
    ``Math.LocalSpurionEvaluation.zero_evaluation_surjective,
    ``Math.JetSpurionEvaluation.direction,
    ``Math.JetSpurionEvaluation.internal,
    ``Math.JetSpurionEvaluation.equation_invariant,
    ``Math.JetSpurionEvaluation.ScalarSource,
    ``Math.JetSpurionEvaluation.scalarAction,
    ``Math.JetSpurionEvaluation.scalarSourceEquiv,
    ``Math.JetSpurionEvaluation.ScalarCoefficients,
    ``Math.JetSpurionEvaluation.scalarCoefficientEquiv,
    ``Math.JetSpurionEvaluation.scalarEvaluation,
    ``Math.JetSpurionEvaluation.scalar_surjective,
    ``Math.JetSpurionEvaluation.scalar_card_surjective,
    ``Math.JetSpurionEvaluation.scalar_nonzero_iff,
    ``Math.JetSpurionEvaluation.scalar_evaluation_off,
    ``Math.JetSpurionEvaluation.scalar_pullback_injective,
    ``Math.JetSpurionEvaluation.mixedRelations,
    ``Math.JetSpurionEvaluation.mixed_stable,
    ``Math.JetSpurionEvaluation.MixedSource,
    ``Math.JetSpurionEvaluation.mixedAction,
    ``Math.JetSpurionEvaluation.mixedSourceEquiv,
    ``Math.JetSpurionEvaluation.MixedCoefficients,
    ``Math.JetSpurionEvaluation.mixedCoefficientEquiv,
    ``Math.JetSpurionEvaluation.mixedEvaluation,
    ``Math.JetSpurionEvaluation.mixed_surjective,
    ``Math.JetSpurionEvaluation.mixed_card_surjective,
    ``Math.JetSpurionEvaluation.mixed_nonzero_iff,
