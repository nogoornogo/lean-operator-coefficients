    ``Math.JetSpurionEvaluation.mixedProjection_surjective,
    ``Math.JetSpurionEvaluation.mixed_evaluation_tensor,
    ``Math.JetSpurionEvaluation.mixed_pullback_injective,
    ``Math.MixedJetSpurionExample.Group,
    ``Math.MixedJetSpurionExample.groupFintype,
    ``Math.MixedJetSpurionExample.group_card,
    ``Math.MixedJetSpurionExample.character,
    ``Math.MixedJetSpurionExample.character_neg_one,
    ``Math.MixedJetSpurionExample.character_square,
    ``Math.MixedJetSpurionExample.sign,
    ``Math.MixedJetSpurionExample.oddField,
    ``Math.MixedJetSpurionExample.evenField,
    ``Math.MixedJetSpurionExample.field_jet,
    ``Math.MixedJetSpurionExample.odd_jet,
    ``Math.MixedJetSpurionExample.action_raw,
    ``Math.MixedJetSpurionExample.sourceAction,
    ``Math.MixedJetSpurionExample.source_sign,
    ``Math.MixedJetSpurionExample.quotientAction,
