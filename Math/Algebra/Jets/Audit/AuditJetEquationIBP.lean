import Math.Audit.ImportOrigin
import Math.Algebra.Jets.ScalarJetEOMQuadratic
import Math.Algebra.Jets.JetEquationProbe
import Math.Algebra.Jets.JetSymbolEvaluation

/-! Strict transitive audit of Equation generators, on-shell algebras and EOM/IBP. -/
open Lean in
run_cmd do
  let env ← getEnv
  for mod in env.header.moduleNames do
    if (`Physics).isPrefixOf mod || (`GUT).isPrefixOf mod then
      throwError "Unexpected source layer {mod}; original {SourceLayout.originalModule mod}"
  let ds := [
    ``Math.JetEquation.generators,
    ``Math.JetEquation.relations,
    ``Math.JetEquation.descendant_mem,
    ``Math.JetEquation.shift_stable,
    ``Math.JetEquation.Generator,
    ``Math.JetEquation.shift,
    ``Math.JetEquation.shift_mk,
    ``Math.JetEquation.shift_commute,
    ``Math.JetEquation.internal_stable,
    ``Math.JetEquation.direction_stable,
    ``Math.JetEquation.combined_stable,
    ``Math.JetEquation.generatorAction,
    ``Math.JetEquation.generator_covariant,
    ``Math.JetEquation.Algebra,
    ``Math.JetEquation.derivative,
    ``Math.JetEquation.derivative_mul,
    ``Math.JetEquation.derivative_commute,
    ``Math.JetEquation.projection,
    ``Math.JetEquation.projection_X,
    ``Math.JetEquation.projection_linearForm,
    ``Math.JetEquation.projection_derivative,
    ``Math.JetEquation.ideal,
    ``Math.JetEquation.ideal_le_ker,
    ``Math.JetEquation.PolynomialQuotient,
    ``Math.JetEquation.toFree,
    ``Math.JetEquation.toFree_mk,
    ``Math.JetEquation.quotientGenerator,
    ``Math.JetEquation.fromFree,
    ``Math.JetEquation.fromFree_generator,
    ``Math.JetEquation.fromFree_projection,
    ``Math.JetEquation.presentationEquiv,
    ``Math.JetEquation.projection_surjective,
    ``Math.JetEquation.projection_ker,
    ``Math.JetEquation.symbolProbe,
    ``Math.JetEquation.symbolProbe_ofSymbols,
    ``Math.JetEquation.symbolProbe_annihilates,
    ``Math.JetEquation.onShellProbe,
    ``Math.JetEquation.onShellProbe_mk,
    ``Math.JetEquation.generator_survives,
    ``Math.JetSymbolEvaluation.linearized,
    ``Math.JetSymbolEvaluation.firstJets,
    ``Math.JetSymbolEvaluation.firstJets_X,
    ``Math.JetSymbolEvaluation.firstJets_linearForm,
    ``Math.JetSymbolEvaluation.linearized_natural,
    ``Math.JetSymbolEvaluation.firstJets_natural,
    ``Math.ScalarJetEOMQuadratic.equation,
    ``Math.ScalarJetEOMQuadratic.higher_relation,
    ``Math.ScalarJetEOMQuadratic.higher_projection,
    ``Math.ScalarJetEOMQuadratic.second_eom,
    ``Math.ScalarJetEOMQuadratic.combinedRelations_top,
    ``Math.ScalarJetEOMQuadratic.CombinedQuotient,
    ``Math.ScalarJetEOMQuadratic.ShellQuotient,
    ``Math.ScalarJetEOMQuadratic.combined_zero,
    ``Math.ScalarJetEOMQuadratic.shell_zero,
    ``Math.ScalarJetEOMQuadratic.shell_finrank,
    ``Math.JetEquation.generatorAction_mk,
    ``Math.JetEquation.action,
    ``Math.JetEquation.projection_action,
    ``Math.JetEquation.ideal_action_stable,
    ``Math.JetEquation.ideal_derivative_stable,
    ``Math.JetEquation.covariance,
    ``Math.JetEquation.grade,
    ``Math.JetEquation.gradeProjection,
    ``Math.JetEquation.gradeProjection_apply,
    ``Math.JetEquation.gradeProjection_surjective,
    ``Math.JetEquation.derivative_mem,
    ``Math.JetEquation.gradeDerivative,
    ``Math.JetEquation.gradeDerivative_apply,
    ``Math.JetEquation.gradeProjection_derivative,
    ``Math.JetEquation.action_mem,
    ``Math.JetEquation.gradeAction,
    ``Math.JetEquation.gradeAction_apply,
    ``Math.JetEquation.grade_covariance,
    ``Math.JetEquation.coefficientEquiv,
    ``Math.JetEquation.offDerivatives,
    ``Math.JetEquation.offRelations,
    ``Math.JetEquation.shellRelations,
    ``Math.JetEquation.shellRelations_map,
    ``Math.JetEquation.combinedRelations,
    ``Math.JetEquation.combinedRelations_comap,
    ``Math.JetEquation.eom_kernel_iff,
    ``Math.JetEquation.combinedProjection,
    ``Math.JetEquation.combinedProjection_ker,
    ``Math.JetEquation.combinedProjection_surjective,
    ``Math.JetEquation.combinedQuotientEquiv,
    ``Math.JetEquation.combinedQuotientEquiv_mk,
    ``Math.JetEquation.combinedCoefficientEquiv,
    ``Math.JetEquation.gradeProjection_equivariant,
    ``Math.JetEquation.shell_stable,
    ``Math.JetEquation.shellQuotientAction,
    ``Math.JetEquation.combinedProjection_equivariant,
    ``Math.JetEquation.combined_stable_action,
    ``Math.JetEquation.combinedAction,
    ``Math.JetEquation.combinedRepresentationEquiv]
  for d in ds do
    for ax in (← Lean.collectAxioms d) do
      unless [``propext, ``Classical.choice, ``Quot.sound].contains ax do
        throwError "Declaration {d} uses unexpected axiom {ax}"
  Lean.logInfo m!"Equation generators, on-shell algebras and EOM/IBP: {ds.length} strict transitive checks passed"
