import TauCeti.Algebra.Lie.Presentation.Serre
import TauCeti.Algebra.Lie.Matrix.IntegralCast
import Mathlib.Algebra.Lie.Basis.Basic

/-!
# A basis for a Lie algebra generated by integral Serre matrices

The generated algebra is defined from the actual raising and lowering matrices.
Independence of the Cartan matrices and nondegeneracy of the Cartan matrix are
separate hypotheses; the Serre relations alone do not imply either assertion.
-/

set_option autoImplicit false

namespace Math.SerreMatrixBasis

open scoped Matrix

noncomputable section

attribute [local instance 100] LieRing.ofAssociativeRing

variable {ι n : Type*} [Fintype ι] [Fintype n] [DecidableEq n]
  (K : Type*) [Field K] [CharZero K]
  (H E F : ι → Matrix n n ℤ)

abbrev castMatrix (M : Matrix n n ℤ) : Matrix n n K :=
  TauCeti.matrixIntCastLieHom K M

omit [Fintype ι] [CharZero K] in
theorem castMatrix_eq_map (M : Matrix n n ℤ) :
    castMatrix K M = M.map (Int.castRingHom K) := by
  ext a b
  simp [castMatrix]

def generated : LieSubalgebra K (Matrix n n K) :=
  .lieSpan K _ (Set.range (fun i => castMatrix K (E i)) ∪
    Set.range (fun i => castMatrix K (F i)))

def e (i : ι) : generated K E F :=
  ⟨castMatrix K (E i), LieSubalgebra.subset_lieSpan (Or.inl ⟨i, rfl⟩)⟩

def f (i : ι) : generated K E F :=
  ⟨castMatrix K (F i), LieSubalgebra.subset_lieSpan (Or.inr ⟨i, rfl⟩)⟩

variable {A : Matrix ι ι ℤ} (hs : TauCeti.IsSerreSystem ℤ Aᵀ H E F)

def h (i : ι) : generated K E F :=
  ⟨castMatrix K (H i), by
    rw [← hs.lie_E_F_self i]
    change (TauCeti.matrixIntCastLieHom K) ⁅E i, F i⁆ ∈ generated K E F
    rw [(TauCeti.matrixIntCastLieHom K).map_lie]
    exact (generated K E F).lie_mem (e K E F i).property (f K E F i).property⟩

def cartan : LieSubalgebra K (generated K E F) :=
  .lieSpan K _ (Set.range (h K H E F hs))

omit [Fintype ι] [CharZero K] in
theorem span_ef :
    LieSubalgebra.lieSpan K (generated K E F)
      (Set.range (e K E F) ∪ Set.range (f K E F)) = ⊤ := by
  have hr : Set.range (e K E F) ∪ Set.range (f K E F) =
      Subtype.val ⁻¹' (Set.range (fun i => castMatrix K (E i)) ∪
        Set.range (fun i => castMatrix K (F i))) := by
    ext x
    simp only [Set.mem_union, Set.mem_range, Set.mem_preimage, e, f, Subtype.ext_iff]
  rw [hr]
  exact LieSubalgebra.lieSpan_lieSpan_coe_preimage

/-- Scalar extension and restriction to the generated carrier give a genuine
`LieAlgebra.Basis`, not a quotient of the Serre presentation assumed faithful. -/
def basis
    (hli : LinearIndependent K (fun i => castMatrix K (H i)))
    (hA : A.Nondegenerate) (hdiag : ∀ i, A i i = 2) :
    LieAlgebra.Basis ι (cartan K H E F hs) where
  A := A
  h := h K H E F hs
  e := e K E F
  f := f K E F
  cartan_eq_lieSpan := rfl
  span_ef := span_ef K E F
  linInd := LinearIndependent.of_comp (generated K E F).subtype hli
  nondegen := hA
  sl2 i :=
    { h_ne_zero := by
        intro hz
        exact hli.ne_zero i (congrArg Subtype.val hz)
      lie_e_f := by
        apply Subtype.ext
        exact ((TauCeti.matrixIntCastLieHom K).map_lie (E i) (F i)).symm.trans
          (congrArg (castMatrix K) (hs.lie_E_F_self i))
      lie_h_e_nsmul := by
        apply Subtype.ext
        change ⁅castMatrix K (H i), castMatrix K (E i)⁆ = 2 • castMatrix K (E i)
        rw [← (TauCeti.matrixIntCastLieHom K).map_lie, hs.lie_H_E]
        simp only [Matrix.transpose_apply, hdiag, ofNat_smul_eq_nsmul, map_nsmul]
      lie_h_f_nsmul := by
        apply Subtype.ext
        change ⁅castMatrix K (H i), castMatrix K (F i)⁆ = -(2 • castMatrix K (F i))
        rw [← (TauCeti.matrixIntCastLieHom K).map_lie, hs.lie_H_F]
        simp only [Matrix.transpose_apply, hdiag, map_neg, ofNat_smul_eq_nsmul, map_nsmul] }
  lie_h_h i j := by
    apply Subtype.ext
    exact ((TauCeti.matrixIntCastLieHom K).map_lie (H i) (H j)).symm.trans
      (by rw [hs.lie_H_H, map_zero]; rfl)
  lie_h_e i j := by
    apply Subtype.ext
    change ⁅castMatrix K (H j), castMatrix K (E i)⁆ = A i j • castMatrix K (E i)
    rw [← (TauCeti.matrixIntCastLieHom K).map_lie, hs.lie_H_E]
    exact map_zsmul _ _ _
  lie_h_f i j := by
    apply Subtype.ext
    change ⁅castMatrix K (H j), castMatrix K (F i)⁆ = -A i j • castMatrix K (F i)
    rw [← (TauCeti.matrixIntCastLieHom K).map_lie, hs.lie_H_F]
    simp only [Matrix.transpose_apply, map_neg, map_zsmul, neg_smul]
  lie_e_f_ne i j hij := by
    apply Subtype.ext
    exact ((TauCeti.matrixIntCastLieHom K).map_lie (E i) (F j)).symm.trans
      (by rw [hs.lie_E_F_of_ne i j hij, map_zero]; rfl)

end

end Math.SerreMatrixBasis
