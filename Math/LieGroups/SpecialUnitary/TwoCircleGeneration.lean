import Math.LieGroups.SpecialUnitary.AffinePairBoundary
import Math.RepresentationTheory.Weights.IntegralTorusTests
import Math.RepresentationTheory.Invariants.FiniteInvariantKernel
import TauCeti.RepresentationTheory.SU2.Basic
import Mathlib.Analysis.SpecialFunctions.Complex.Arg

/-! Actual SU(2) is generated by two fixed circle families, via explicit Euler factors. -/
namespace Math.TwoCircleGeneration
set_option autoImplicit false
noncomputable section
open Matrix Representation
abbrev SU2 := specialUnitaryGroup (Fin 2) ℂ

def mix : SU2 :=
  ⟨!![(1+Complex.I)/2, (1+Complex.I)/2;
      -(1-Complex.I)/2, (1-Complex.I)/2], by
    rw [mem_specialUnitaryGroup_iff]
    constructor
    · rw [mem_unitaryGroup_iff]
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [Matrix.mul_apply, Fin.sum_univ_two, Matrix.star_apply, Complex.conj_ofNat] <;>
        apply Complex.ext <;> norm_num
    · simp [Matrix.det_fin_two]
      apply Complex.ext <;> norm_num⟩

def rotation (z : Circle) : SU2 :=
  ⟨!![(z : ℂ).re, (z : ℂ).im; -(z : ℂ).im, (z : ℂ).re], by
    have hn : (z : ℂ).re^2 + (z : ℂ).im^2 = 1 := by
      have he : Complex.normSq (z : ℂ) = 1 := by
        rw [Complex.normSq_eq_norm_sq, Circle.norm_coe, one_pow]
      simpa [Complex.normSq_apply, pow_two] using he
    have hc : ((z : ℂ).re : ℂ)^2 + ((z : ℂ).im : ℂ)^2 = 1 := by exact_mod_cast hn
    rw [mem_specialUnitaryGroup_iff]
    constructor
    · rw [mem_unitaryGroup_iff]
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [Matrix.mul_apply, Fin.sum_univ_two, Matrix.star_apply] <;>
        first | (solve | ring) | (solve | linear_combination hc)
    · simp [Matrix.det_fin_two]; linear_combination hc⟩

theorem rotation_conjugate (z : Circle) :
    rotation z = mix * TauCeti.SU2.torusHom z * mix⁻¹ := by
  apply Subtype.ext
  ext i j
  change (rotation z).val i j =
    (mix.val * (TauCeti.SU2.torusHom z).val * star mix.val) i j
  have hinv : ((z : ℂ))⁻¹ = star (z : ℂ) := by
    simpa [Complex.star_def] using Circle.coe_inv_eq_conj z
  fin_cases i <;> fin_cases j <;>
    simp [rotation, mix, Matrix.mul_apply, Matrix.vecMul, dotProduct, Fin.sum_univ_two, Matrix.star_apply, Complex.conj_ofNat,
      TauCeti.SU2.coe_torusHom, TauCeti.SU2.torusMatrix, hinv] <;>
    apply Complex.ext <;> simp <;> ring

theorem first_row_ext (g h : SU2) (ha : g.val 0 0 = h.val 0 0)
    (hb : g.val 0 1 = h.val 0 1) : g=h := by
  have hg := Matrix.specialUnitaryGroup.star_eq_adjugate g
  have hh := Matrix.specialUnitaryGroup.star_eq_adjugate h
  have g11 : g.val 1 1 = star (g.val 0 0) := by
    have he := congrArg (fun M : Matrix (Fin 2) (Fin 2) ℂ => M 0 0) hg
    simpa [Matrix.star_apply, Matrix.adjugate_fin_two, Matrix.trace, Fin.sum_univ_two] using he.symm
  have h11 : h.val 1 1 = star (h.val 0 0) := by
    have he := congrArg (fun M : Matrix (Fin 2) (Fin 2) ℂ => M 0 0) hh
    simpa [Matrix.star_apply, Matrix.adjugate_fin_two, Matrix.trace, Fin.sum_univ_two] using he.symm
  have g10 : g.val 1 0 = -star (g.val 0 1) := by
    have he := congrArg (fun M : Matrix (Fin 2) (Fin 2) ℂ => M 1 0) hg
    simpa [Matrix.star_apply, Matrix.adjugate_fin_two, Matrix.trace, Fin.sum_univ_two] using congrArg Neg.neg he.symm
  have h10 : h.val 1 0 = -star (h.val 0 1) := by
    have he := congrArg (fun M : Matrix (Fin 2) (Fin 2) ℂ => M 1 0) hh
    simpa [Matrix.star_apply, Matrix.adjugate_fin_two, Matrix.trace, Fin.sum_univ_two] using congrArg Neg.neg he.symm
  apply Subtype.ext
  ext i j
  fin_cases i <;> fin_cases j <;> simp [ha,hb,g11,h11,g10,h10]

/-- All zero-entry cases are included by the norm/argument identity. -/
theorem euler (g : SU2) :
    ∃ z w v : Circle, g = TauCeti.SU2.torusHom z * rotation w * TauCeti.SU2.torusHom v := by
  let a := g.val 0 0
  let b := g.val 0 1
  let z := Circle.exp ((a.arg+b.arg)/2)
  let v := Circle.exp ((a.arg-b.arg)/2)
  have hn : ‖a‖^2 + ‖b‖^2 = 1 := by
    simpa [a,b,Complex.normSq_eq_norm_sq] using AffinePairBoundary.row_norm g
  let w : Circle := ⟨(‖a‖ : ℂ) + (‖b‖ : ℂ)*Complex.I, by
    apply mem_sphere_zero_iff_norm.mpr
    apply (sq_eq_sq₀ (norm_nonneg _) (by norm_num : (0:ℝ)≤1)).mp
    simpa [Complex.sq_norm, Complex.normSq_add_mul_I] using hn⟩
  have hzv : z*v = Circle.exp a.arg := by
    dsimp only [z,v]
    rw [← Circle.exp_add]
    congr 1
    ring
  have hzvi : z*v⁻¹ = Circle.exp b.arg := by
    dsimp only [z,v]
    rw [← Circle.exp_neg, ← Circle.exp_add]
    congr 1
    ring
  have ha : (z : ℂ) * (v : ℂ) * (‖a‖ : ℂ) = a := by
    rw [← Circle.coe_mul, hzv, Circle.coe_exp]
    simpa [mul_comm] using Complex.norm_mul_exp_arg_mul_I a
  have hb : (z : ℂ) * ((v : ℂ))⁻¹ * (‖b‖ : ℂ) = b := by
    rw [← Circle.coe_inv, ← Circle.coe_mul, hzvi, Circle.coe_exp]
    simpa [mul_comm] using Complex.norm_mul_exp_arg_mul_I b
  refine ⟨z,w,v,first_row_ext g _ ?_ ?_⟩
  · change a = ((TauCeti.SU2.torusHom z).val * (rotation w).val * (TauCeti.SU2.torusHom v).val) 0 0
    simpa [rotation,w,Matrix.mul_apply,Fin.sum_univ_two,TauCeti.SU2.coe_torusHom,
      TauCeti.SU2.torusMatrix, mul_assoc, mul_comm, mul_left_comm] using ha.symm
  · change b = ((TauCeti.SU2.torusHom z).val * (rotation w).val * (TauCeti.SU2.torusHom v).val) 0 1
    simpa [rotation,w,Matrix.mul_apply,Fin.sum_univ_two,TauCeti.SU2.coe_torusHom,
      TauCeti.SU2.torusMatrix, mul_assoc, mul_comm, mul_left_comm] using hb.symm

/-- Circle invariance exhausts actual SU(2) invariance in any representation. -/
theorem invariant {V : Type*} [AddCommGroup V] [Module ℂ V]
    (rho : Representation ℂ SU2 V) (f : Module.Dual ℂ V)
    (ht : ∀ z x, f (rho (TauCeti.SU2.torusHom z) x)=f x)
    (hc : ∀ z x, f (rho (mix * TauCeti.SU2.torusHom z * mix⁻¹) x)=f x) :
    ∀ g x, f (rho g x)=f x := by
  intro g x
  obtain ⟨z,w,v,rfl⟩ := euler g
  simp_rw [map_mul, Module.End.mul_apply]
  rw [ht, rotation_conjugate, hc, ht]

def tests (b : Bool) : SU2 := if b then
  mix * TauCeti.SU2.torusHom IntegralTorusTests.sample * mix⁻¹
  else TauCeti.SU2.torusHom IntegralTorusTests.sample

theorem exhaustive {V : Type*} [AddCommGroup V] [Module ℂ V]
    (rho : Representation ℂ SU2 V)
    (hi : IntegralTorusTests.Integral rho TauCeti.SU2.torusHom) :
    FiniteInvariantKernel.Exhaustive rho tests := by
  intro f hf
  apply invariant rho f
  · exact IntegralTorusTests.invariant rho _ hi f (hf false)
  · exact IntegralTorusTests.conjugate_invariant rho _ hi mix f (hf true)

end
end Math.TwoCircleGeneration