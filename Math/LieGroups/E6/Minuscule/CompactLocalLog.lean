import Math.LieGroups.E6.Minuscule.CompactIdentityComponent
import Math.LieGroups.Matrix.MatrixLieGroupLocalLog
import Mathlib.Topology.Algebra.OpenSubgroup

/-!
# Local matrix logarithm in the actual E6 real form

Near the identity the logarithm lies in the actual real form and exponentiates
back to the group element. Consequently the identity component is open.
It equals the algebraic subgroup generated by real-form exponentials.
This does not supply manifold charts or the compact E6 global identification.
-/

set_option autoImplicit false

namespace Math.E6.Minuscule

noncomputable section

open NormedSpace Filter
open scoped Matrix Matrix.Norms.L2Operator Topology

abbrev compactLocalLog (g : compactNormalizer) : Matrix27 :=
  MatrixLieGroupNormalizer.localLog compactMatrixLieAlgebra g

theorem eventually_exp_mem_normalizer_iff :
    ∀ᶠ X : Matrix27 in 𝓝 0, exp X ∈ compactNormalizerMatrices ↔ X ∈ compactMatrixLieAlgebra := by
  filter_upwards [MatrixLieGroupNormalizer.eventually_exp_mem_matrixCarrier_iff
    compactMatrixLieAlgebra] with X hX
  exact hX.trans (compactMatrix_mem_iff_normalizes_skew_trace_zero X).symm

theorem eventually_compactLocalLog_mem :
    ∀ᶠ g : compactNormalizer in 𝓝 1, compactLocalLog g ∈ compactMatrixLieAlgebra := by
  filter_upwards [MatrixLieGroupNormalizer.eventually_localLog_conditions compactMatrixLieAlgebra]
    with g hg
  exact (compactMatrix_mem_iff_normalizes_skew_trace_zero _).mpr hg

theorem eventually_exp_compactLocalLog :
    ∀ᶠ g : compactNormalizer in 𝓝 1, exp (compactLocalLog g) = (g.val : Matrix27) :=
  MatrixLieGroupNormalizer.eventually_exp_localLog compactMatrixLieAlgebra

theorem eventually_local_realForm_exp :
    ∀ᶠ g : compactNormalizer in 𝓝 1,
      ∃ X ∈ compactMatrixLieAlgebra, exp X = (g.val : Matrix27) := by
  filter_upwards [eventually_compactLocalLog_mem, eventually_exp_compactLocalLog] with g hm he
  exact ⟨compactLocalLog g, hm, he⟩

theorem mem_identityComponent_of_realForm_exp (g : compactNormalizer) (X : Matrix27)
    (hX : X ∈ compactMatrixLieAlgebra) (he : exp X = (g.val : Matrix27)) :
    g ∈ compactIdentityComponent := by
  have hm : exp X ∈ compactIdentityMatrices := by
    simpa using (mem_compactMatrix_iff_exp_mem_identityComponent X).mp hX 1
  obtain ⟨h, hh, heq⟩ := (MatrixLieGroupNormalizer.mem_componentMatrices _ _).mp hm
  have hhg : h = g := Subtype.ext (Subtype.ext (heq.trans he))
  exact hhg ▸ hh

theorem eventually_mem_compactIdentityComponent :
    ∀ᶠ g : compactNormalizer in 𝓝 1, g ∈ compactIdentityComponent := by
  filter_upwards [eventually_local_realForm_exp] with g hg
  obtain ⟨X, hX, he⟩ := hg
  exact mem_identityComponent_of_realForm_exp g X hX he

theorem compactIdentityComponent_isOpen :
    IsOpen (compactIdentityComponent : Set compactNormalizer) :=
  compactIdentityComponent.isOpen_of_mem_nhds eventually_mem_compactIdentityComponent

/-- An actual positive-radius neighborhood, not a supplied smallness certificate. -/
theorem exists_exp_criterion_radius :
    ∃ ε > (0 : ℝ), ∀ X : Matrix27, ‖X‖ < ε →
      (exp X ∈ compactNormalizerMatrices ↔ X ∈ compactMatrixLieAlgebra) := by
  simpa only [dist_zero_right] using Metric.eventually_nhds_iff.mp
    eventually_exp_mem_normalizer_iff

theorem exists_localLog_radius :
    ∃ ε > (0 : ℝ), ∀ g : compactNormalizer, dist g 1 < ε →
      compactLocalLog g ∈ compactMatrixLieAlgebra ∧
        exp (compactLocalLog g) = (g.val : Matrix27) :=
  Metric.eventually_nhds_iff.mp
    (eventually_compactLocalLog_mem.and eventually_exp_compactLocalLog)

/-- Algebraic subgroup generation, not topological closure. -/
def compactExponentialSubgroup : Subgroup compactNormalizer :=
  Subgroup.closure {g | ∃ X ∈ compactMatrixLieAlgebra, exp X = (g.val : Matrix27)}

theorem compactExponentialSubgroup_le : compactExponentialSubgroup ≤ compactIdentityComponent := by
  apply (Subgroup.closure_le compactIdentityComponent).mpr
  rintro g ⟨X, hX, he⟩
  exact mem_identityComponent_of_realForm_exp g X hX he

theorem compactExponentialSubgroup_isOpen :
    IsOpen (compactExponentialSubgroup : Set compactNormalizer) := by
  apply compactExponentialSubgroup.isOpen_of_mem_nhds (g := 1)
  filter_upwards [eventually_local_realForm_exp] with g hg
  exact Subgroup.subset_closure hg

theorem compactExponentialSubgroup_eq_identityComponent :
    compactExponentialSubgroup = compactIdentityComponent := by
  apply le_antisymm compactExponentialSubgroup_le
  have hc : IsClopen (compactExponentialSubgroup : Set compactNormalizer) :=
    ⟨compactExponentialSubgroup.isClosed_of_isOpen compactExponentialSubgroup_isOpen,
      compactExponentialSubgroup_isOpen⟩
  exact hc.connectedComponent_subset compactExponentialSubgroup.one_mem

end

end Math.E6.Minuscule
