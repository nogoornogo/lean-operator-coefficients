import Math.LieGroups.E6.Minuscule.MatrixLieAlgebra
import Math.LieAlgebras.SerreMatrixBasis

/-!
# Pinned Cartan bases of the minuscule matrix Lie algebras

Both carriers are generated by the pinned integral E6 matrices. The D5 basis
uses the already checked Bourbaki-numbered subdiagram. No comparison with a
compact group, or with the kernel of a Serre presentation, is assumed here.
-/

set_option autoImplicit false
set_option maxRecDepth 16000
set_option maxHeartbeats 4000000

namespace Math.E6.Minuscule

open TauCeti.E6Minuscule SparseMatrixCertificate LieData LieChecks
open scoped Matrix

noncomputable section

attribute [local instance 100] LieRing.ofAssociativeRing

def e6CartanIndex (i : Fin 6) : Fin 78 := ⟨12 + i.val, by omega⟩
def d5CartanIndex (i : Fin 5) : Fin 45 := ⟨10 + i.val, by omega⟩

theorem e6_cartan_checked (i : Fin 6) :
    eval (e6Basis (e6CartanIndex i)) = cartanGeneratorMatrix i := by
  decide +kernel +revert

theorem d5_cartan_checked (i : Fin 5) :
    eval (d5Basis (d5CartanIndex i)) = cartanGeneratorMatrix (d5Node i) := by
  decide +kernel +revert

theorem d5_isSerreSystem : TauCeti.IsSerreSystem ℤ (CartanMatrix.D 5)ᵀ
    (cartanGeneratorMatrix ∘ d5Node) (raisingMatrix ∘ d5Node) (loweringMatrix ∘ d5Node) := by
  have heq : (CartanMatrix.E 6)ᵀ.submatrix d5Node d5Node = (CartanMatrix.D 5)ᵀ := by
    ext i j
    exact d5_cartan j i
  rw [← heq]
  exact isSerreSystem.submatrix d5Node_injective

private theorem range_append {a b : ℕ} {T : Type*} (v : Fin a → T) (w : Fin b → T) :
    Set.range (Fin.append v w) = Set.range v ∪ Set.range w := by
  ext x
  constructor
  · rintro ⟨i, rfl⟩
    refine Fin.addCases (fun j => ?_) (fun j => ?_) i
    · exact Or.inl ⟨j, by simp⟩
    · exact Or.inr ⟨j, by simp⟩
  · rintro (⟨i, rfl⟩ | ⟨i, rfl⟩)
    · exact ⟨Fin.castAdd b i, by simp⟩
    · exact ⟨Fin.natAdd a i, by simp⟩

variable (K : Type*) [Field K] [CharZero K]

theorem matrixCartan_linearIndependent :
    LinearIndependent K (fun i => SerreMatrixBasis.castMatrix K (cartanGeneratorMatrix i)) := by
  have hli := (matrixBasis_linearIndependent K).comp e6CartanIndex
    (by intro i j hij; apply Fin.ext; have := congrArg Fin.val hij; simpa [e6CartanIndex] using this)
  simpa only [Function.comp_def, realize, e6_cartan_checked,
    SerreMatrixBasis.castMatrix_eq_map] using hli

theorem d5MatrixCartan_linearIndependent :
    LinearIndependent K
      (fun i => SerreMatrixBasis.castMatrix K (cartanGeneratorMatrix (d5Node i))) := by
  have hli := (d5MatrixBasis_linearIndependent K).comp d5CartanIndex
    (by intro i j hij; apply Fin.ext; have := congrArg Fin.val hij; simpa [d5CartanIndex] using this)
  simpa only [Function.comp_def, realize, d5_cartan_checked,
    SerreMatrixBasis.castMatrix_eq_map] using hli

omit [CharZero K] in
theorem generated_eq_matrixLieAlgebra :
    SerreMatrixBasis.generated K raisingMatrix loweringMatrix = matrixLieAlgebra K := by
  have hg : (fun i => (e6GeneratorInt i).map (Int.castRingHom K)) =
      Fin.append (fun i => SerreMatrixBasis.castMatrix K (raisingMatrix i))
        (fun i => SerreMatrixBasis.castMatrix K (loweringMatrix i)) := by
    funext i
    fin_cases i <;> rfl
  simp only [SerreMatrixBasis.generated, matrixLieAlgebra, hg, range_append (a := 6) (b := 6)]

omit [CharZero K] in
theorem generated_eq_d5MatrixLieAlgebra :
    SerreMatrixBasis.generated K (raisingMatrix ∘ d5Node) (loweringMatrix ∘ d5Node) =
      d5MatrixLieAlgebra K := by
  have hg : (fun i => (d5GeneratorInt i).map (Int.castRingHom K)) =
      Fin.append (fun i => SerreMatrixBasis.castMatrix K (raisingMatrix (d5Node i)))
        (fun i => SerreMatrixBasis.castMatrix K (loweringMatrix (d5Node i))) := by
    funext i
    fin_cases i <;> rfl
  simp only [SerreMatrixBasis.generated, d5MatrixLieAlgebra, hg,
    range_append (a := 5) (b := 5), Function.comp_apply]

/-- The actual E6 matrix algebra carries the specified Cartan basis. -/
def matrixCartanBasis : LieAlgebra.Basis (Fin 6)
    (SerreMatrixBasis.cartan K cartanGeneratorMatrix raisingMatrix loweringMatrix isSerreSystem) :=
  SerreMatrixBasis.basis K _ _ _ isSerreSystem (matrixCartan_linearIndependent K)
    (by rw [Matrix.nondegenerate_iff_det_ne_zero]; decide +kernel)
    (by decide +kernel)

/-- The actual D5 matrix subalgebra carries its Bourbaki-numbered Cartan basis. -/
def d5MatrixCartanBasis : LieAlgebra.Basis (Fin 5)
    (SerreMatrixBasis.cartan K (cartanGeneratorMatrix ∘ d5Node)
      (raisingMatrix ∘ d5Node) (loweringMatrix ∘ d5Node) d5_isSerreSystem) :=
  SerreMatrixBasis.basis K _ _ _ d5_isSerreSystem (d5MatrixCartan_linearIndependent K)
    (by rw [Matrix.nondegenerate_iff_det_ne_zero]; decide +kernel)
    (by decide +kernel)

@[simp] theorem matrixCartanBasis_A : (matrixCartanBasis K).A = CartanMatrix.E 6 := rfl
@[simp] theorem d5MatrixCartanBasis_A : (d5MatrixCartanBasis K).A = CartanMatrix.D 5 := rfl

end

end Math.E6.Minuscule
