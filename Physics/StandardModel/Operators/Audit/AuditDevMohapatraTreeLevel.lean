  for decl in ds do
    for ax in (← Lean.collectAxioms decl) do
      unless [``propext, ``Classical.choice, ``Quot.sound].contains ax do
        throwError "Dev tree-level: {decl} uses unexpected axiom {ax}"
  Lean.logInfo m!"Dev tree-level: {ds.length} strict transitive checks passed"
