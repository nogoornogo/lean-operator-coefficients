import Physics.StandardModel.Operators.DevMohapatraTreeLevel
import Math.Audit.ImportOrigin
import Lean.Util.CollectAxioms

run_cmd do
  for mod in (← Lean.getEnv).header.moduleNames do
    if (`GUT).isPrefixOf mod then
      throwError "Dev tree-level imports upper layer {mod}; original {SourceLayout.originalModule mod}"
  let ds := [``GUT.DevMohapatraTreeLevel.A,
    ``GUT.DevMohapatraTreeLevel.pair,
    ``GUT.DevMohapatraTreeLevel.pair_symmetric,
    ``GUT.DevMohapatraTreeLevel.majorana_half,
    ``GUT.DevMohapatraTreeLevel.source_generator_order,
    ``GUT.DevMohapatraTreeLevel.cubic,
    ``GUT.DevMohapatraTreeLevel.cubic_apply,
    ``GUT.DevMohapatraTreeLevel.cubic_swap,
    ``GUT.DevMohapatraTreeLevel.generator_cubic_swap,
    ``GUT.DevMohapatraTreeLevel.even_product_commutes,
    ``GUT.DevMohapatraTreeLevel.pair_commutes,
    ``GUT.DevMohapatraTreeLevel.Index,
    ``GUT.DevMohapatraTreeLevel.colorWeight,
    ``GUT.DevMohapatraTreeLevel.term,
    ``GUT.DevMohapatraTreeLevel.current,
    ``GUT.DevMohapatraTreeLevel.current_swap,
    ``GUT.DevMohapatraTreeLevel.generator_current_swap,
    ``GUT.DevMohapatraTreeLevel.downCurrent,
    ``GUT.DevMohapatraTreeLevel.downCurrent_swap,
    ``GUT.DevMohapatraTreeLevel.ordered_flavor_sum,
    ``GUT.DevMohapatraTreeLevel.current_color,
    ``GUT.DevMohapatraTreeLevel.scalar_vertex,
    ``GUT.DevMohapatraTreeLevel.downCurrent_commutes,
    ``GUT.DevMohapatraTreeLevel.current_product,
    ``GUT.DevMohapatraTreeLevel.printedOperator,
    ``GUT.DevMohapatraTreeLevel.printedOperator_eq,
    ``GUT.DevMohapatraTreeLevel.treePrefactor,
    ``GUT.DevMohapatraTreeLevel.treePrefactor_down_rescaling,
    ``GUT.DevMohapatraTreeLevel.effectiveCoupling,
    ``GUT.DevMohapatraTreeLevel.scalar_elimination,
    ``GUT.DevMohapatraTreeLevel.scalar_on_shell,
    ``GUT.DevMohapatraTreeLevel.majorana_elimination,
    ``GUT.DevMohapatraTreeLevel.generated,
    ``GUT.DevMohapatraTreeLevel.nuVertex,
    ``GUT.DevMohapatraTreeLevel.nuVertex_sum,
    ``GUT.DevMohapatraTreeLevel.uvAction,
    ``GUT.DevMohapatraTreeLevel.chiSolution,
    ``GUT.DevMohapatraTreeLevel.chiBarSolution,
    ``GUT.DevMohapatraTreeLevel.nSolution,
    ``GUT.DevMohapatraTreeLevel.uv_after_scalar,
