import Physics.StandardModel.Operators.Selection.InverseCyclicSMYukawa
import Lean.Util.CollectAxioms
run_cmd do
  let ds := [``Physics.InverseCyclicSMCharges.yukawa_parametrization,
    ``Physics.InverseCyclicSMCharges.physical_dictionary,
    ``Physics.InverseCyclicSMCharges.all_family_charges,
    ``Physics.InverseCyclicSMCharges.bounded_four_forbidden_iff,
    ``Physics.InverseCyclicSMCharges.three_generation_necessary,
    ``Physics.InverseCyclicSMCharges.universal_qque_charge,
    ``Physics.InverseCyclicSMCharges.universal_qqql_charge,
    ``Physics.InverseCyclicSMCharges.three_generation_sufficient,
    ``Physics.InverseCyclicSMCharges.three_generation_forbidden_iff,
    ``Physics.InverseCyclicSMCharges.three_generation_allowed_iff,
    ``Physics.InverseCyclicSMCharges.candidate_iff_three_generation_forbidden,
    ``Physics.InverseCyclicSMCharges.not_candidate_iff_three_generation_allowed,
    ``Physics.InverseCyclicSMCharges.mem_candidates,
    ``Physics.InverseCyclicSMCharges.counts,
    ``Physics.InverseCyclicSMCharges.initial_count,
    ``Physics.InverseCyclicSMCharges.surviving_count,
    ``Physics.InverseCyclicSMCharges.selected_candidate,
    ``Physics.InverseCyclicSMCharges.selected_least,
    ``Physics.InverseLeptonParitySelection.total_lepton,
    ``Physics.InverseLeptonParitySelection.species_parity,
    ``Physics.InverseLeptonParitySelection.content_parity,
    ``Physics.InverseLeptonParitySelection.field_scalar,
    ``Physics.InverseLeptonParitySelection.scalar_scalar,
    ``Physics.InverseLeptonParitySelection.charge_of_nonzero,
    ``Physics.InverseLeptonParitySelection.baryon_even,
    ``Physics.InverseLeptonParitySelection.forbidden_values,
    ``Physics.InverseLeptonParitySelection.all_forbidden,
    ``Physics.InverseLeptonParitySelection.residual_forbidden,
    ``Physics.ConstructedSpectatorRadical.mem_radical,
    ``Physics.ConstructedSpectatorRadical.radicalEquiv,
    ``Physics.InverseCyclicSMRealization.species_gauge,
    ``Physics.InverseCyclicSMRealization.gauge_restriction,
    ``Physics.InverseCyclicSMRealization.threeCopies,
    ``Physics.InverseCyclicSMRealization.radicalEquiv,
    ``Physics.InverseCyclicSMRealization.spectator_mass_nonzero,
    ``Physics.InverseCyclicSMRealization.coefficient_species,
    ``Physics.InverseCyclicSMRealization.physicalFieldEquiv,
    ``Physics.InverseCyclicSMRealization.selected_dictionary,
    ``Physics.InverseCyclicSMRealization.higgs_residual_neutral,
    ``Physics.InverseCyclicSMRealization.flavorDual_action,
    ``Physics.InverseCyclicSMRealization.flavorDualEquiv,
    ``Physics.InverseCyclicSMRealization.all_B1_forbidden,
    ``Physics.SMYukawaContractions.upMap,
    ``Physics.SMYukawaContractions.downMap,
    ``Physics.SMYukawaContractions.electronMap,
    ``Physics.SMYukawaContractions.up_witness,
    ``Physics.SMYukawaContractions.down_witness,
    ``Physics.SMYukawaContractions.electron_witness,
    ``Physics.SMYukawaContractions.upOrdered_apply,
    ``Physics.SMYukawaContractions.downOrdered_apply,
    ``Physics.SMYukawaContractions.electronOrdered_apply,
    ``Physics.TwoSpeciesExteriorYukawa.coefficient,
    ``Physics.TwoSpeciesExteriorYukawa.slots,
    ``Physics.TwoSpeciesExteriorYukawa.nonzero,
    ``Physics.SpinorYukawaContraction.regroup,
    ``Physics.SpinorYukawaContraction.ordered_apply,
    ``Physics.SpinorYukawaContraction.exterior_nonzero,
    ``Physics.InverseCyclicSMYukawa.flavorPair,
    ``Physics.InverseCyclicSMYukawa.internal_apply,
    ``Physics.InverseCyclicSMYukawa.up_nonzero,
    ``Physics.InverseCyclicSMYukawa.down_nonzero,
    ``Physics.InverseCyclicSMYukawa.electron_nonzero,
    ``Physics.InverseCyclicSMYukawa.construction_certificate]
  for d in ds do
    for ax in (← Lean.collectAxioms d) do
      unless [``propext, ``Classical.choice, ``Quot.sound].contains ax do
        throwError "Inverse cyclic SM construction: {d} uses unexpected axiom {ax}"
  Lean.logInfo m!"Inverse cyclic SM construction: {ds.length} strict transitive checks passed"
